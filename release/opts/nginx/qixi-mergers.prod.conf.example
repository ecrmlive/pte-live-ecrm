# 宿主机 Nginx · 生产模板
# 后台域名 → api-admin；C 端 / 回调域名 → api-app

upstream qixi_mergers_api_admin {
    server 127.0.0.1:18080;
    # server 172.30.80.20:8080;
}

upstream qixi_mergers_api_app {
    server 127.0.0.1:18085;
    # server 172.30.80.22:8080;
}

# —— 后台 API（可选独立域名）——
server {
    listen 443 ssl http2;
    server_name api-admin.example.com;

    location / {
        proxy_pass http://qixi_mergers_api_admin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# —— C 端 API + 支付回调 ——
server {
    listen 443 ssl http2;
    server_name api.example.com;

    location / {
        proxy_pass http://qixi_mergers_api_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# —— 平台后台 ——
server {
    listen 443 ssl http2;
    server_name admin.example.com;
    root /home/ubuntu/qixi-mergers/qixi-mergers-admin/dist;
    index index.html;

    location /api/ {
        proxy_pass http://qixi_mergers_api_admin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# —— 商户后台 ——
server {
    listen 443 ssl http2;
    server_name mer.example.com;
    root /home/ubuntu/qixi-mergers/qixi-mergers-merchant-admin/dist;
