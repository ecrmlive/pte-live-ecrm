# Job local 模板；pack 以 api/conf/job.yaml 为准覆盖 config/local/app.yaml
server:
  addr: ":8080"
  mode: debug

mysql:
  dsn: "qixi:qixi_local@tcp(qixi_mergers_mysql:3306)/qixi_mergers?charset=utf8mb4&parseTime=True&loc=Local"

redis:
  addr: "qixi_mergers_redis:6379"
  password: ""
  db: 0

nats:
  url: "nats://qixi_mergers_nats:4222"

etcd:
  endpoints:
    - "qixi_mergers_etcd:2379"

minio:
  endpoint: "qixi_mergers_minio:9000"
  access_key: "qixi_minio"
  secret_key: "qixi_minio_secret"
  bucket: "qixi-mergers"
  use_ssl: false

job:
  tick_seconds: 30
  unpaid_ttl_minutes: 30
  unpaid_batch: 50
