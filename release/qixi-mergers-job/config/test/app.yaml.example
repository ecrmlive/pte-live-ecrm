# 测试服务器配置；与 local 使用完全相同的运行参数。
server:
  addr: ":8080"
  mode: debug
mysql:
  dsn: "qixi:qixi_local@tcp(pte_live_mysql:3306)/qixi_mergers?charset=utf8mb4&parseTime=True&loc=Local"
redis:
  addr: "pte_live_redis:6379"
  password: ""
  db: 0
nats:
  url: "nats://pte_live_nats1:4222,nats://pte_live_nats2:4222,nats://pte_live_nats3:4222"
etcd:
  endpoints: ["pte_live_etcd1:2379", "pte_live_etcd2:2379", "pte_live_etcd3:2379"]
cos:
  enabled: true
  bucket: ""
  region: "ap-guangzhou"
  secret_id: ""
  secret_key: ""
  base_url: "https://cos.qxkejiwl.top/qixi-mergers"
  key_prefix: "qixi-mergers"

# Job 不签发用户令牌，但加载此项以保持三套后端共享同一 JWT 配置契约。
jwt:
  secret: "" # 与 local/test 的其余五份后端 app.yaml 保持同一值
  access_ttl_hours: 12
  refresh_ttl_hours: 168

job:
  tick_seconds: 30
  unpaid_ttl_minutes: 30
  unpaid_batch: 50
