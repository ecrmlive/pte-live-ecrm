# C 端 API（api-app）主配置；pack 同步到 release/qixi-mergers-api-app/config/{local,prod}/app.yaml
server:
  addr: ":8080"
  mode: debug

mysql:
  dsn: "qixi:qixi_local@tcp(pte_live_mysql:3306)/qixi_mergers?charset=utf8mb4&parseTime=True&loc=Local"

redis:
  addr: "pte_live_redis:6379"
  password: ""
  db: 0

nats:
  url: "nats://pte_live_nats1:4222,nats://pte_live_nats2:4222,nats://pte_live_nats3:4222"

etcd:
  endpoints:
    - "pte_live_etcd1:2379"
    - "pte_live_etcd2:2379"
    - "pte_live_etcd3:2379"

cos:
  enabled: true
  bucket: ""
  region: "ap-guangzhou"
  secret_id: ""
  secret_key: ""
  base_url: "https://cos.qxkejiwl.top/qixi-mergers"
  key_prefix: "qixi-mergers"

jwt:
  secret: "qixi-mergers-dev-jwt-secret-change-me"
  access_ttl_hours: 12
  refresh_ttl_hours: 168

# 支付：sandbox=true 时下发 notify_token，回调 HMAC 验签后走 paySuccess（非真实微信/支付宝 SDK）
payment:
  sandbox: true
  notify_secret: "qixi-pay-notify-dev-secret-change-me"
  wechat: true
  alipay: true

im:
  mode: local
  api_base: "http://pte_live_api_im:11504"
  ws_public_url: "ws://127.0.0.1:11510/ws"
  app_id: "30001"
  integration_token: ""
