# Job 主配置；pack 同步到 release/pte-live-ecrm-job/config/{local,prod}/app.yaml
server:
  addr: ":8080"
  mode: debug

mysql:
  dsn: "qixi:qixi_local@tcp(pte_live_mysql:3306)/pte_live_ecrm?charset=utf8mb4&parseTime=True&loc=Local"

redis:
  addr: "pte_live_redis:6379"
  password: ""
  db: 0

nats:
  url: "nats://pte_live_nats1:4222,nats://pte_live_nats2:4222,nats://pte_live_nats3:4222"

etcd:
  endpoints:
    - "pte_live_etcd1:2379"
    - "pte_live_etcd2:2379"
    - "pte_live_etcd3:2379"

cos:
  enabled: true
  bucket: ""
  region: "ap-guangzhou"
  secret_id: ""
  secret_key: ""
  base_url: "https://cos.qxkejiwl.top/pte-live-ecrm"
  key_prefix: "pte-live-ecrm"

job:
  tick_seconds: 30
  unpaid_ttl_minutes: 30
  unpaid_batch: 50
