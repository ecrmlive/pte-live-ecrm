import { appRequest } from "./request"

type Presign={object_key:string;upload_url:string;headers:UTSJSONObject}

function bytes(path:string):Promise<ArrayBuffer>{return new Promise((resolve,reject)=>{
  // #ifdef WEB
  uni.request({url:path,method:"GET",responseType:"arraybuffer",success:(response)=>{if(response.statusCode>=200&&response.statusCode<300&&response.data instanceof ArrayBuffer)resolve(response.data as ArrayBuffer);else reject(new Error("无法读取营业执照文件"))},fail:()=>reject(new Error("无法读取营业执照文件"))})
  // #endif
  // #ifndef WEB
  try{const value=uni.getFileSystemManager().readFileSync(path);if(value instanceof ArrayBuffer)resolve(value as ArrayBuffer);else reject(new Error("无法读取营业执照文件"))}catch(_){reject(new Error("无法读取营业执照文件"))}
  // #endif
})}
export function uploadMerchantLicense(path:string,name:string,mimeType:string,size:number):Promise<string>{
 if(path.length==0||name.length==0||size<=0)return Promise.reject(new Error("请选择营业执照图片"))
 return appRequest("/uploads/presign","POST",{filename:name,content_type:mimeType,size:size,purpose:"merchant_application_license"} as UTSJSONObject).then((data)=>{const intent=data as Presign;return bytes(path).then((body)=>new Promise<UTSJSONObject>((resolve,reject)=>{uni.request({url:intent.upload_url,method:"PUT",data:body,header:intent.headers,success:(response)=>{if(response.statusCode>=200&&response.statusCode<300)resolve({object_key:intent.object_key} as UTSJSONObject);else reject(new Error("营业执照上传失败"))},fail:()=>reject(new Error("营业执照上传失败"))})}))}).then((uploaded)=>appRequest("/uploads/complete","POST",{object_key:uploaded["object_key"] as string,purpose:"merchant_application_license"} as UTSJSONObject).then((done)=>done["object_key"] as string))
}
