<script setup lang="uts">
import { appRequest } from "../../common/request"
type Info={server_date:string;signed_today:boolean;today_points:number;daily_reward:number;continuous_days:number};type SignResult={already_signed:boolean;signed_today:boolean;points:number;continuous_days:number};type Row={id:number;sign_date:string;points:number;continuous_days:number};type Page={month:string;list:Row[]};const info=ref<Info>({server_date:"",signed_today:false,today_points:0,daily_reward:0,continuous_days:0});const records=ref<Row[]>([]);const loading=ref(false);const signing=ref(false)
function load():void{loading.value=true;appRequest("/sign/info").then((data)=>info.value=data as Info).catch((error)=>uni.showToast({title:error.message||"签到状态加载失败",icon:"none"}));appRequest("/sign/month").then((data)=>records.value=(data as Page).list||[]).catch(()=>records.value=[]).finally(()=>loading.value=false)}
function sign():void{if(info.value.signed_today){uni.showToast({title:"今天已经签到",icon:"none"});return};signing.value=true;appRequest("/sign/create","POST").then((data)=>{const result=data as SignResult;info.value.signed_today=true;info.value.today_points=result.points;info.value.continuous_days=result.continuous_days;uni.showToast({title:result.already_signed?"今天已经签到":"签到成功，获得"+result.points+"积分",icon:result.already_signed?"none":"success"});load()}).catch((error)=>uni.showToast({title:error.message||"签到失败",icon:"none"})).finally(()=>signing.value=false)}
onShow(()=>load())
</script><template><view class="qx-page"><qx-nav title="每日签到"/><view class="hero"><text class="caption">连续签到</text><text class="days">{{info.continuous_days}} 天</text><text class="tip">每日签到可获得 {{info.daily_reward}} 积分</text><button :loading="signing" class="sign" @click="sign">{{info.signed_today?"今日已签到":"立即签到"}}</button></view><view class="section">本月签到记录</view><view v-if="records.length==0&&!loading" class="qx-card empty">本月还没有签到记录</view><view v-for="item in records" :key="item.id" class="qx-card row"><view><text class="date">{{item.sign_date}}</text><text class="days-text">连续 {{item.continuous_days}} 天</text></view><text class="points">+{{item.points}} 积分</text></view></view></template><style>.hero{padding:28px 18px;color:#fff;text-align:center;background:linear-gradient(135deg,#d85c22,#f0a53d)}.caption,.days,.tip{display:block}.caption{font-size:13px;opacity:.85}.days{margin-top:5px;font-size:34px;font-weight:700}.tip{margin-top:8px;font-size:13px}.sign{width:150px;margin:18px auto 0;color:#c45a25;background:#fff;border-radius:22px;font-size:14px;font-weight:600}.section{padding:14px;color:#4e5969;font-size:14px;font-weight:600}.empty{color:#86909c;text-align:center}.row{display:flex;align-items:center;justify-content:space-between}.date,.days-text{display:block}.date{font-weight:600}.days-text{margin-top:6px;color:#86909c;font-size:12px}.points{color:#d85c22;font-weight:600}</style>