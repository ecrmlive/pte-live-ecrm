<script setup lang="uts">
import { appRequest } from '../../common/request'

type Coupon = { coupon_user_id: number; coupon_title: string; coupon_price: number; use_min_price: number; status: number }
type CouponData = { list: Coupon[] }
const status = ref(0)
const items = ref<Coupon[]>([])
function load(): void { appRequest(`/coupons/mine?status=${status.value}&page=1&limit=30`).then((data) => { items.value = (data as CouponData).list || [] }).catch((error) => uni.showToast({ title: error.message || '加载失败', icon: 'none' })) }
function switchStatus(value: number): void { status.value = value; load() }
onShow(() => load())
</script>

<template><view class="qx-page"><qx-nav title="我的优惠券" /><view class="tabs"><text :class="status == 0 ? 'active' : ''" @click="switchStatus(0)">未使用</text><text :class="status == 1 ? 'active' : ''" @click="switchStatus(1)">已使用</text><text :class="status == 2 ? 'active' : ''" @click="switchStatus(2)">已过期</text></view><view v-if="items.length == 0" class="qx-card empty">暂无优惠券</view><view v-for="item in items" :key="item.coupon_user_id" class="qx-card"><text class="title">{{ item.coupon_title }}</text><text class="sub">¥{{ item.coupon_price }} · 满 {{ item.use_min_price }} 可用</text></view></view></template>

<style>.tabs { padding: 14px 20px; background-color: #ffffff; display: flex; justify-content: space-around; }.tabs text { color: #86909c; font-size: 14px; }.tabs .active { color: #d72828; font-weight: 600; }.empty { text-align: center; color: #86909c; }.title { display: block; font-size: 16px; font-weight: 600; }.sub { display: block; margin-top: 8px; color: #86909c; font-size: 13px; }</style>
