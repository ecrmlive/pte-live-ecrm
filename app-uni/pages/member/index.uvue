<script setup lang="uts">
import { appRequest } from "../../common/request"
type Current={level_id:number;level_name:string;rank:number;rules:string;benefits:string};type Level={id:number;name:string;rank:number;rules:string;benefits:string};type Info={current:Current;levels:Level[]};type Log={id:number;level_name:string;previous_level_name:string;change_type:string;note:string;created_at:string};type LogPage={list:Log[];total:number;page:number;limit:number};const current=ref<Current>({level_id:0,level_name:"普通会员",rank:0,rules:"[]",benefits:"[]"});const levels=ref<Level[]>([]);const logs=ref<Log[]>([]);const loading=ref(false);const logPage=ref(1);const logTotal=ref(0);const logLimit=20;function hasMore():boolean{return logs.value.length<logTotal.value}
function changeText(value:string):string{return value=="upgrade"?"等级升级":value=="downgrade"?"等级调整":value=="manual"?"人工调整":"开通会员"}
function loadLogs(reset:boolean=false):void{if(loading.value||(!reset&&!hasMore()))return;const next=reset?1:logPage.value+1;loading.value=true;appRequest("/member/log?page="+next).then((data)=>{const result=data as LogPage;logPage.value=result.page||next;logTotal.value=result.total||0;logs.value=reset?(result.list||[]):logs.value.concat(result.list||[])}).catch(()=>{if(reset)logs.value=[]}).finally(()=>loading.value=false)}
function load():void{appRequest("/member/info").then((data)=>{const result=data as Info;current.value=result.current||current.value;levels.value=result.levels||[]}).catch((error)=>uni.showToast({title:error.message||"会员信息加载失败",icon:"none"}));loadLogs(true)}
onShow(()=>load())
onReachBottom(()=>loadLogs())
</script><template><view class="qx-page"><qx-nav title="会员中心"/><view class="hero"><text class="caption">当前会员</text><text class="name">{{current.level_name}}</text><text class="rank">会员等级 {{current.rank}}</text></view><view class="qx-card svip-link" @click="uni.navigateTo({url:'/pages/funding/svip'})"><view><text class="link-title">开通 SVIP</text><text class="link-hint">解锁会员专享价格与服务</text></view><text>›</text></view><view class="section">会员等级</view><view class="qx-card"><view v-for="level in levels" :key="level.id" class="level"><view><text class="level-name">{{level.name}}</text><text class="level-rank">等级 {{level.rank}}</text></view><text v-if="level.id==current.level_id" class="active">当前等级</text></view><view v-if="levels.length==0&&!loading" class="empty">暂无可用会员等级</view></view><view class="section">成长记录</view><view v-if="logs.length==0&&!loading" class="qx-card empty">暂无会员成长记录</view><view v-for="item in logs" :key="item.id" class="qx-card log"><view><text class="log-title">{{changeText(item.change_type)}}：{{item.level_name}}</text><text class="log-note">{{item.note}}</text><text class="time">{{item.created_at}}</text></view></view></view></template><style>.svip-link{display:flex;align-items:center;justify-content:space-between;margin:12px 12px 0}.link-title,.link-hint{display:block}.link-title{font-weight:600}.link-hint{margin-top:5px;color:#86909c;font-size:12px}.hero{padding:26px 18px;color:#fff;background:linear-gradient(135deg,#392861,#7455aa)}.caption,.name,.rank{display:block}.caption{font-size:13px;opacity:.8}.name{margin-top:7px;font-size:30px;font-weight:700}.rank{margin-top:8px;font-size:13px;opacity:.9}.section{padding:14px;color:#4e5969;font-size:14px;font-weight:600}.level{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f2f3f5}.level:last-child{border-bottom:0}.level-name,.level-rank,.log-title,.log-note,.time{display:block}.level-name,.log-title{font-weight:600}.level-rank,.log-note,.time{margin-top:5px;color:#86909c;font-size:12px}.active{padding:3px 8px;color:#fff;background:#7455aa;border-radius:12px;font-size:11px}.empty{color:#86909c;text-align:center}.log{margin-top:8px}</style>