<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
import { activateMerchantContext } from '../../common/store-context'

type SKU = { sku_key: string; spec_text: string; price: string; stock: number }

type ProductDetail = {
  id: number
  mer_id: number
  mer_name: string
  brand_name: string
  title: string
  store_id: number
  store_name: string
  shop_name: string
  store_info: string
  image: string
  slider_image: string[]
  price: string
  ot_price: string
  svip_price_type: number
  svip_price: string
  stock: number
  sales: number
  merchant_app_id: string
  unit_name: string
  delivery_way: string
  sku_list: SKU[]
}

const detail = ref<ProductDetail | null>(null)
const productID = ref(0)
const adding = ref(false)
const buying = ref(false)
const activeImage = ref(0)
const favorite = ref(false)
const favoriteChanging = ref(false)
const selectedSKUKey = ref('')
const purchaseQuantity = ref(1)
type Comment = { comment_id:number; score:number; content:string; reply_content:string; create_time:string }
type CommentPage = { list: Comment[] }
const comments = ref<Comment[]>([])

function hasDetail(): boolean { return detail.value != null }
function hasOriginalPrice(): boolean { const product = detail.value; return product != null && product.ot_price.length > 0 }
function originalPrice(): string { const product = detail.value; return product == null ? '--' : product.ot_price }
function saleCount(): number { const product = detail.value; return product == null ? 0 : product.sales }
function hasDescription(): boolean { const product = detail.value; return product != null && product.store_info.length > 0 }
function description(): string { const product = detail.value; return product == null ? '--' : product.store_info }
function selectedSpecText(): string { const product = detail.value; const sku = selectedSKU(); const spec = sku == null ? '默认规格' : sku.spec_text; const unit = product == null || product.unit_name.length == 0 ? '件' : product.unit_name; return spec + ' · 库存 ' + displayStock().toString() + ' ' + unit }
function deliveryText(): string { const product = detail.value; return product == null ? '--' : (product.delivery_way == 'express' ? '快递配送' : product.delivery_way) }
function shopName(): string { const product = detail.value; if (product == null) return '平台自营'; if (product.shop_name.length > 0) return product.shop_name; if (product.mer_name.length > 0) return product.mer_name; return '平台自营' }
function productName(): string { return detail.value == null ? '' : (detail.value.title || detail.value.store_name || '商品') }
function brandName(): string { return detail.value == null ? '' : detail.value.brand_name }
function skuList(): SKU[] { return detail.value == null ? [] : (detail.value.sku_list || []) }
function selectedSKU(): SKU | null {
  const rows = skuList()
  for (const row of rows) { if (row.sku_key == selectedSKUKey.value) return row }
  return rows.length > 0 ? rows[0] : null
}
function displayPrice(): string { const sku = selectedSKU(); return sku == null ? (detail.value == null ? '' : detail.value.price) : sku.price }
function displayStock(): number { const sku = selectedSKU(); return sku == null ? (detail.value == null ? 0 : detail.value.stock) : sku.stock }
function svipHint(): string {
  if (detail.value == null) return ""
  if (detail.value.svip_price_type == 1) return "SVIP 下单享 9 折"
  if (detail.value.svip_price_type == 2 && detail.value.svip_price.length > 0) return "SVIP 专享 ¥" + detail.value.svip_price
  return ""
}
function selectedQuantity(): number { return purchaseQuantity.value }
function decreaseQuantity(): void { if (purchaseQuantity.value > 1) purchaseQuantity.value -= 1 }
function increaseQuantity(): void { if (displayStock() > purchaseQuantity.value) purchaseQuantity.value += 1 }
function quantityAtMax(): boolean { return displayStock() <= purchaseQuantity.value }
function canPurchase(): boolean { return purchaseQuantity.value > 0 && displayStock() >= purchaseQuantity.value }
function chooseSKU(key: string): void {
  selectedSKUKey.value = key
  const stock = displayStock()
  if (purchaseQuantity.value > stock) purchaseQuantity.value = stock > 0 ? stock : 1
}
function images(): string[] {
  if (detail.value == null) return []
  const values = detail.value.slider_image || []
  if (values.length > 0) return values.filter((value) => String(value || '').trim().length > 0)
  const image = String(detail.value.image || '').trim()
  return image.length > 0 ? [image] : []
}
function load(id: number): void {
  appRequest(`/catalog/products/${id}`, 'GET', null, false).then((data) => {
    detail.value = data as ProductDetail
    activeImage.value = 0
    const skus = detail.value.sku_list || []
    selectedSKUKey.value = skus.length > 0 ? skus[0].sku_key : ''
    purchaseQuantity.value = 1
    appRequest("/products/" + id + "/comments", "GET", null, false).then((rows) => { comments.value = (rows as CommentPage).list || [] }).catch(() => { comments.value = [] })
    if (getAccessToken().length > 0) appRequest("/history/products/" + id, "POST").catch(() => {})
    if (getAccessToken().length > 0) {
      appRequest("/favorites/products/" + id, "GET").then((status) => { favorite.value = (status as UTSJSONObject)["followed"] as boolean }).catch(() => { favorite.value = false })
    } else { favorite.value = false }
    const product = detail.value as ProductDetail
    if (getAccessToken().length > 0 && product.merchant_app_id.length > 0) {
      activateMerchantContext(product.merchant_app_id).catch(() => uni.showToast({ title: '请重新登录后再购买此店铺商品', icon: 'none' }))
    }
  }).catch((error) => uni.showToast({ title: error.message || '商品加载失败', icon: 'none' }))
}
function withMerchantContext(action: () => Promise<UTSJSONObject>): Promise<UTSJSONObject> {
  if (detail.value == null || detail.value.merchant_app_id.length == 0) return action()
  return activateMerchantContext(detail.value.merchant_app_id).then(() => action())
}
function addCart(): void {
  if (detail.value == null || adding.value) return
  if (getAccessToken().length == 0) { uni.navigateTo({ url: "/pages/login/index" }); return }
  if (!canPurchase()) { uni.showToast({ title: "当前规格库存不足", icon: "none" }); return }
  adding.value = true
  withMerchantContext(() => appRequest("/cart", "POST", { product_id: detail.value!.id, cart_num: purchaseQuantity.value, product_attr_unique: selectedSKUKey.value } as UTSJSONObject)).then(() => {
    uni.showToast({ title: "已加入购物车", icon: "none" })
  }).catch((error) => uni.showToast({ title: error.message || "加购失败", icon: "none" })).finally(() => { adding.value = false })
}
function buyNow(): void {
  if (detail.value == null || buying.value) return
  if (getAccessToken().length == 0) { uni.navigateTo({ url: "/pages/login/index" }); return }
  if (!canPurchase()) { uni.showToast({ title: "当前规格库存不足", icon: "none" }); return }
  buying.value = true
  withMerchantContext(() => appRequest("/cart", "POST", { product_id: detail.value!.id, cart_num: purchaseQuantity.value, product_attr_unique: selectedSKUKey.value } as UTSJSONObject)).then((data) => {
    const cartID = Number((data as UTSJSONObject)["cart_id"] || 0)
    if (cartID <= 0) throw new Error("购物车创建失败")
    uni.navigateTo({ url: "/pages/order/checkout?cart_ids=" + cartID })
  }).catch((error) => uni.showToast({ title: error.message || "立即购买失败", icon: "none" })).finally(() => { buying.value = false })
}
function goStore(): void { if (detail.value != null && detail.value.mer_id > 0) uni.navigateTo({ url: `/pages/store/home?mer_id=${detail.value.mer_id}` }) }
function contactService(): void {
  if (detail.value == null) return
  if (getAccessToken().length == 0) { uni.navigateTo({ url: '/pages/login/index' }); return }
  uni.navigateTo({ url: `/pages/cs/chat?mer_id=${detail.value.mer_id}` })
}
function toggleFavorite(): void {
  if (detail.value == null || favoriteChanging.value) return
  if (getAccessToken().length == 0) { uni.navigateTo({ url: "/pages/login/index" }); return }
  favoriteChanging.value = true
  const method = favorite.value ? "DELETE" : "PUT"
  appRequest("/favorites/products/" + detail.value.id, method).then((data) => {
    favorite.value = (data as UTSJSONObject)["followed"] as boolean
    uni.showToast({ title: favorite.value ? "已收藏" : "已取消收藏", icon: "none" })
  }).catch((error) => uni.showToast({ title: error.message || "收藏操作失败", icon: "none" })).finally(() => { favoriteChanging.value = false })
}
function goCart(): void { uni.switchTab({ url: "/pages/cart/index" }) }

onLoad((query) => { productID.value = Number(query?.['id'] || 0); if (productID.value > 0) load(productID.value) })
</script>

<template>
  <view v-if="hasDetail()" class="detail-page">
    <view class="detail-header"><text class="detail-header__back" @click="uni.navigateBack()">‹</text><text class="detail-header__title">商品详情</text><view class="detail-header__actions"><text class="detail-header__favorite" @click="toggleFavorite">{{ favorite ? "已收藏" : "收藏" }}</text><text class="detail-header__cart" @click="goCart">购物车</text></view></view>
    <swiper v-if="images().length > 0" class="detail-gallery" circular indicator-dots @change="(event) => activeImage = event.detail.current"><swiper-item v-for="(image, index) in images()" :key="`${image}-${index}`"><image class="detail-gallery__image" :src="image" mode="aspectFill" /></swiper-item></swiper>
    <view v-else class="detail-gallery detail-gallery--empty"><text>暂无商品图片</text></view>
    <view class="detail-price-card"><view><text class="detail-price-card__price">¥{{ displayPrice() }}</text><text v-if="hasOriginalPrice()" class="detail-price-card__original">¥{{ originalPrice() }}</text></view><view class="detail-price-card__right"><text v-if="svipHint()" class="detail-price-card__svip">{{ svipHint() }}</text><text class="detail-price-card__sales">已售 {{ saleCount() }}</text></view></view>
    <view class="detail-main"><text class="detail-main__name">{{ productName() }}</text><text v-if="hasDescription()" class="detail-main__description">{{ description() }}</text><view v-if="brandName()" class="detail-main__line"><text>品牌</text><text>{{ brandName() }}</text></view><view class="detail-main__line"><text>已选规格</text><text>{{ selectedSpecText() }}</text></view><view v-if="skuList().length > 1" class="detail-skus"><text class="detail-skus__title">选择规格</text><view class="detail-skus__options"><button v-for="sku in skuList()" :key="sku.sku_key" class="detail-skus__option" :class="{ 'detail-skus__option--active': selectedSKUKey == sku.sku_key, 'detail-skus__option--disabled': sku.stock <= 0 }" :disabled="sku.stock <= 0" @click="chooseSKU(sku.sku_key)">{{ sku.spec_text }} · ¥{{ sku.price }}</button></view></view><view class="detail-main__line"><text>购买数量</text><view class="detail-quantity"><text class="detail-quantity__button" v-on:click="decreaseQuantity">−</text><text class="detail-quantity__value">{{ selectedQuantity() }}</text><text class="detail-quantity__button" :class="{ 'detail-quantity__button--disabled': quantityAtMax() }" v-on:click="increaseQuantity">+</text></view></view><view class="detail-main__line"><text>配送服务</text><text>{{ deliveryText() }}</text></view></view>
    <view class="detail-comments"><text class="detail-comments__title">商品评价</text><text v-if="comments.length==0" class="detail-comments__empty">暂无已审核评价</text><view v-for="comment in comments" :key="comment.comment_id" class="detail-comments__item"><text>{{comment.score}} 星 · {{comment.content}}</text><text v-if="comment.reply_content" class="detail-comments__reply">商家回复：{{comment.reply_content}}</text></view></view>
    <view class="detail-shop" @click="goStore"><view class="detail-shop__badge">店</view><view class="detail-shop__content"><text class="detail-shop__name">{{ shopName() }}</text><text class="detail-shop__hint">进入店铺查看全部商品</text></view><text class="detail-shop__arrow">›</text></view>
    <view class="detail-service"><text>服务保障</text><text>正品保障 · 售后无忧 · 安全支付</text></view>
    <view class="detail-footer"><view class="detail-footer__service" @click="contactService"><text>客服</text></view><view class="detail-footer__service" @click="goCart"><text>购物车</text></view><button :loading="adding" class="detail-footer__add detail-footer__add--secondary" @click="addCart">加入购物车</button><button :loading="buying" class="detail-footer__add" @click="buyNow">立即购买</button></view>
  </view>
</template>

<style>
.detail-page { min-height: 100vh; padding-bottom: 62px; background-color: #f6f6f6; }.detail-header { height: 44px; padding-top: var(--status-bar-height); display: flex; align-items: center; justify-content: space-between; padding-left: 12px; padding-right: 12px; box-sizing: content-box; background-color: #ffffff; }.detail-header__back { width: 27px; color: #333333; font-size: 31px; line-height: 31px; text-align: center; }.detail-header__title { color: #222222; font-size: 17px; font-weight: 600; }.detail-header__actions { width: 90px; display: flex; align-items: center; justify-content: flex-end; gap: 10px; }.detail-header__favorite { color: #d72828; font-size: 12px; }.detail-header__cart { width: 36px; color: #555555; font-size: 12px; text-align: right; }.detail-gallery { width: 100%; height: 330px; background-color: #f1f1f1; }.detail-gallery__image { width: 100%; height: 330px; display: block; }.detail-gallery--empty { display: flex; align-items: center; justify-content: center; color: #999999; background-color: #fff0ee; font-size: 14px; }
.detail-price-card { min-height: 55px; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; color: #ffffff; background: linear-gradient(100deg, #e72b2b, #ff6449); }.detail-price-card__price { font-size: 27px; font-weight: 700; }.detail-price-card__original { margin-left: 7px; color: #ffd8d2; font-size: 12px; text-decoration: line-through; }.detail-price-card__right{display:flex;flex-direction:column;align-items:flex-end;gap:4px}.detail-price-card__sales{font-size:12px}.detail-price-card__svip{padding:2px 6px;border-radius:8px;color:#6f4a00;background:#ffe7a3;font-size:10px}
.detail-main { margin-bottom: 10px; padding: 14px 13px 1px; background-color: #ffffff; }.detail-main__name { display: block; color: #222222; font-size: 18px; font-weight: 700; line-height: 25px; }.detail-main__description { display: block; margin-top: 8px; color: #888888; font-size: 13px; line-height: 19px; }.detail-main__line { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 14px; color: #888888; border-top: 1px solid #f4f4f4; font-size: 13px; }.detail-main__line:first-of-type { margin-top: 14px; }.detail-main__line text:first-child { color: #333333; }.detail-main__line text:last-child { overflow: hidden; text-align: right; white-space: nowrap; text-overflow: ellipsis; }
.detail-skus { margin-top: 12px; padding-top: 12px; border-top: 1px solid #f4f4f4; }.detail-skus__title { display: block; color: #333333; font-size: 14px; font-weight: 600; }.detail-skus__options { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }.detail-skus__option { height: 32px; margin: 0; padding: 0 11px; border: 1px solid #e5e5e5; border-radius: 5px; color: #555555; background: #ffffff; font-size: 12px; line-height: 30px; }.detail-skus__option--active { border-color: #d72828; color: #d72828; background: #fff4f3; }.detail-skus__option--disabled { color: #bbbbbb; background: #f7f7f7; }.detail-quantity { display: flex; align-items: center; gap: 10px; }.detail-quantity__button { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 4px; color: #333333; background: #f3f4f6; font-size: 19px; line-height: 28px; }.detail-quantity__button--disabled { color: #c9cdd4; }.detail-quantity__value { min-width: 24px; color: #333333; text-align: center; font-size: 14px; }
.detail-comments { margin-bottom: 10px; padding: 14px 13px; background-color: #ffffff; }.detail-comments__title { display: block; color: #333333; font-size: 15px; font-weight: 600; }.detail-comments__empty { display: block; margin-top: 10px; color: #999999; font-size: 13px; }.detail-comments__item { margin-top: 10px; color: #4e5969; font-size: 13px; line-height: 20px; }.detail-comments__reply { display: block; margin-top: 4px; color: #00b42a; }.detail-shop { margin-bottom: 10px; padding: 14px 13px; display: flex; align-items: center; background-color: #ffffff; }.detail-shop__badge { width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 6px; color: #ffffff; background-color: #d72828; font-size: 16px; font-weight: 700; }.detail-shop__content { min-width: 0; flex: 1; margin-left: 10px; display: flex; flex-direction: column; }.detail-shop__name { overflow: hidden; color: #333333; font-size: 15px; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }.detail-shop__hint { margin-top: 5px; color: #999999; font-size: 12px; }.detail-shop__arrow { color: #999999; font-size: 23px; }.detail-service { padding: 13px; display: flex; align-items: center; justify-content: space-between; color: #777777; background-color: #ffffff; font-size: 12px; }.detail-service text:first-child { color: #333333; font-weight: 600; }
.detail-footer { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; height: 61px; display: flex; align-items: center; padding: 0 10px; box-sizing: border-box; border-top: 1px solid #eeeeee; background-color: #ffffff; }.detail-footer__service { width: 48px; display: flex; flex-direction: column; align-items: center; color: #555555; font-size: 11px; }.detail-footer__add { height: 38px; flex: 1; min-width: 0; margin: 0 0 0 8px; border-radius: 20px; color: #ffffff; background: linear-gradient(90deg, #ff6a47, #d72828); font-size: 15px; line-height: 38px; }.detail-footer__add--secondary{background:linear-gradient(90deg,#ff9a3d,#ff6a47)}
</style>
