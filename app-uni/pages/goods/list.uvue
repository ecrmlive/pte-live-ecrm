<script setup lang="uts">
import { appRequest } from '../../common/request'

type Product = {
  id: number
  mer_id: number
  mer_name: string
  title: string
  store_name: string
  shop_name: string
  image: string
  price: string
  ot_price: string
  sales: number
}
type ProductPage = { list: Product[]; total: number; page: number; limit: number }

const keyword = ref('')
const cateID = ref(0)
const items = ref<Product[]>([])
const page = ref(1)
const total = ref(0)
const loading = ref(false)
const loadingMore = ref(false)

function productName(product: Product): string { return product.title || product.store_name || '商品' }
function productImage(product: Product): string { return String(product.image || '').trim() }
function canLoadMore(): boolean { return items.value.length < total.value }

function load(reset: boolean = true): void {
  if (loading.value || loadingMore.value) return
  const nextPage = reset ? 1 : page.value + 1
  if (!reset && !canLoadMore()) return
  if (reset) loading.value = true
  else loadingMore.value = true
  const params = [`page=${nextPage}`, 'limit=20']
  const queryKeyword = keyword.value.trim()
  if (queryKeyword.length > 0) params.push(`keyword=${encodeURIComponent(queryKeyword)}`)
  if (cateID.value > 0) params.push(`cate_id=${cateID.value}`)
  appRequest(`/catalog/products?${params.join('&')}`, 'GET', null, false).then((data) => {
    const result = data as ProductPage
    const nextItems = result.list || []
    items.value = reset ? nextItems : items.value.concat(nextItems)
    total.value = Number(result.total || 0)
    page.value = Number(result.page || nextPage)
  }).catch((error) => {
    uni.showToast({ title: error.message || '商品加载失败', icon: 'none' })
  }).finally(() => {
    loading.value = false
    loadingMore.value = false
  })
}

function search(): void { load(true) }
function goDetail(id: number): void { uni.navigateTo({ url: `/pages/goods/detail?id=${id}` }) }
function goStore(product: Product): void { if (product.mer_id > 0) uni.navigateTo({ url: `/pages/store/home?mer_id=${product.mer_id}` }) }

onLoad((query) => {
  cateID.value = Number(query['cate_id'] || 0)
  load(true)
})
onReachBottom(() => load(false))
</script>

<template>
  <view class="goods-page">
    <view class="goods-header"><view class="goods-header__back" @click="uni.navigateBack()">‹</view><view class="goods-header__search"><text>⌕</text><input v-model="keyword" class="goods-header__input" confirm-type="search" placeholder="搜索商品" @confirm="search" /><text v-if="keyword.length > 0" class="goods-header__clear" @click="keyword = ''; search()">×</text></view><text class="goods-header__action" @click="search">搜索</text></view>
    <view class="goods-filter"><text :class="{ 'goods-filter__active': cateID == 0 }" @click="cateID = 0; search()">综合</text><text>销量</text><text>价格</text><text @click="uni.navigateTo({ url: '/pages/category/index' })">分类</text></view>
    <view v-if="loading && items.length == 0" class="goods-loading">正在加载商品…</view>
    <view v-else-if="items.length == 0" class="goods-empty"><text>暂无符合条件的商品</text><text class="goods-empty__hint">可调整关键词后重新搜索</text></view>
    <view v-else class="goods-grid"><view v-for="product in items" :key="product.id" class="goods-card" @click="goDetail(product.id)"><image v-if="productImage(product).length > 0" class="goods-card__image" :src="productImage(product)" mode="aspectFill" /><view v-else class="goods-card__image goods-card__image--empty"><text>商品</text></view><view class="goods-card__body"><text class="goods-card__name">{{ productName(product) }}</text><text v-if="product.shop_name || product.mer_name" class="goods-card__shop" @click.stop="goStore(product)">{{ product.shop_name || product.mer_name }}</text><view class="goods-card__price-row"><view><text class="goods-card__price">¥{{ product.price }}</text><text v-if="product.ot_price" class="goods-card__original">¥{{ product.ot_price }}</text></view><text class="goods-card__sales">已售{{ product.sales }}</text></view></view></view></view>
    <view v-if="items.length > 0" class="goods-more"><text v-if="loadingMore">正在加载更多…</text><text v-else-if="canLoadMore()">上拉加载更多</text><text v-else>已加载全部商品</text></view>
  </view>
</template>

<style>
.goods-page { min-height: 100vh; padding-bottom: 12px; background-color: #f6f6f6; }.goods-header { height: 44px; padding-top: var(--status-bar-height); display: flex; align-items: center; gap: 9px; padding-left: 11px; padding-right: 11px; box-sizing: content-box; background-color: #ffffff; }.goods-header__back { width: 25px; color: #333333; font-size: 31px; line-height: 31px; text-align: center; }.goods-header__search { height: 32px; min-width: 0; flex: 1; display: flex; align-items: center; padding: 0 10px; border-radius: 17px; color: #777777; background-color: #f4f4f4; }.goods-header__search text:first-child { margin-right: 6px; font-size: 18px; }.goods-header__input { min-width: 0; flex: 1; font-size: 13px; }.goods-header__clear { color: #999999; font-size: 18px; }.goods-header__action { color: #d72828; font-size: 14px; white-space: nowrap; }.goods-filter { height: 40px; display: flex; align-items: center; justify-content: space-around; color: #666666; border-top: 1px solid #f2f2f2; background-color: #ffffff; font-size: 13px; }.goods-filter__active { position: relative; color: #d72828; font-weight: 700; }.goods-filter__active::after { position: absolute; left: 50%; bottom: -11px; width: 20px; height: 2px; border-radius: 1px; background-color: #d72828; content: ''; transform: translateX(-50%); }
.goods-grid { display: flex; flex-wrap: wrap; gap: 9px; padding: 10px 10px 0; }.goods-card { width: calc(50% - 4.5px); overflow: hidden; border-radius: 8px; background-color: #ffffff; }.goods-card__image { width: 100%; height: 168px; display: block; background-color: #f0f0f0; }.goods-card__image--empty { display: flex; align-items: center; justify-content: center; color: #d72828; background-color: #fff0ee; font-size: 16px; }.goods-card__body { padding: 8px 9px 10px; }.goods-card__name { min-height: 36px; color: #2b2b2b; font-size: 14px; line-height: 18px; overflow: hidden; }.goods-card__shop { display: block; margin-top: 4px; overflow: hidden; color: #999999; font-size: 11px; white-space: nowrap; text-overflow: ellipsis; }.goods-card__price-row { margin-top: 7px; display: flex; align-items: baseline; justify-content: space-between; }.goods-card__price { color: #d72828; font-size: 17px; font-weight: 700; }.goods-card__original { margin-left: 5px; color: #aaaaaa; font-size: 10px; text-decoration: line-through; }.goods-card__sales { color: #aaaaaa; font-size: 10px; }.goods-loading, .goods-empty { min-height: 220px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #999999; font-size: 14px; }.goods-empty__hint { margin-top: 8px; font-size: 12px; }.goods-more { height: 43px; display: flex; align-items: center; justify-content: center; color: #999999; font-size: 12px; }
</style>
