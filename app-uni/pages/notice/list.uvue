<script setup lang="uts">
import { appRequest } from '../../common/request'

type Notice = { notice_id: number; title: string; create_time: string }
type NoticePage = { list: Notice[] }
const items = ref<Notice[]>([])
const loading = ref(false)

function load(): void {
  loading.value = true
  appRequest('/notices?page=1&limit=50', 'GET', null, false).then((data) => { items.value = (data as NoticePage).list || [] }).catch((error) => uni.showToast({ title: error.message || '公告加载失败', icon: 'none' })).finally(() => { loading.value = false })
}
function detail(id: number): void { uni.navigateTo({ url: `/pages/notice/detail?id=${id}` }) }
onShow(() => load())
</script>

<template>
  <view class="qx-page"><qx-nav title="平台公告" /><view v-if="items.length == 0 && !loading" class="qx-card empty">暂无平台公告</view><view v-for="item in items" :key="item.notice_id" class="qx-card item" @click="detail(item.notice_id)"><text class="title">{{ item.title }}</text><text class="time">{{ item.create_time }}</text><text class="arrow">›</text></view></view>
</template>

<style>
.empty { color: #86909c; text-align: center; }.item { position: relative; padding-right: 34px; }.title, .time { display: block; }.title { font-size: 16px; font-weight: 600; }.time { margin-top: 8px; color: #86909c; font-size: 12px; }.arrow { position: absolute; top: 26px; right: 16px; color: #86909c; font-size: 22px; }
</style>
