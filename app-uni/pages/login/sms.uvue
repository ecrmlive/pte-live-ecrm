<script setup lang="uts">
import { appRequest } from '../../common/request'
import { captchaGatewayURL } from '../../common/api'
import { setAccessToken } from '../../common/session'
const mobile=ref('');const code=ref('');const answer=ref('');const image=ref('');const id=ref('');const token=ref('');const seconds=ref(0);const busy=ref(false)
function request(path:string,data:UTSJSONObject):Promise<UTSJSONObject>{return new Promise<UTSJSONObject>((resolve,reject)=>{uni.request({url:captchaGatewayURL(path),method:'POST',data:data,header:{'Content-Type':'application/json'} as UTSJSONObject,success:(r)=>{const b=r.data as UTSJSONObject;if(r.statusCode>=200&&r.statusCode<300){resolve(b);return};reject(new Error(String(b['error']||'安全验证失败')))},fail:()=>reject(new Error('安全验证服务连接失败'))})})}
function signal():UTSJSONObject{return {fingerprint:'crm-sms-'+Date.now(),event_count:1,duration_ms:0,language:'zh-CN'} as UTSJSONObject}
function valid():boolean{return /^1[3-9]\d{9}$/.test(mobile.value.trim())}
function load():void{token.value='';answer.value='';request('/challenges',{action:'login_sms',preferred_mode:'image',locale:'zh-CN',theme:'light',client:signal()} as UTSJSONObject).then(d=>{id.value=String(d['challenge_id']||'');image.value='data:image/png;base64,'+String(d['image_png_base64']||'')}).catch(e=>uni.showToast({title:e.message||'加载失败',icon:'none'}))}
function verify():void{if(answer.value.trim().length==0){uni.showToast({title:'请输入图形验证码',icon:'none'});return};request('/challenges/'+id.value+'/verify',{answer:answer.value.trim(),client:signal()} as UTSJSONObject).then(d=>{token.value=String(d['verification_token']||'');if(token.value.length==0)throw new Error('验证失败');uni.showToast({title:'安全验证通过',icon:'success'})}).catch(e=>{uni.showToast({title:e.message||'验证失败',icon:'none'});load()})}
function send():void{if(!valid()||token.value.length==0){uni.showToast({title:valid()?'请先完成安全验证':'请输入正确手机号',icon:'none'});return};busy.value=true;appRequest('/auth/sms/send','POST',{mobile:mobile.value.trim(),purpose:'login',captcha_token:token.value} as UTSJSONObject,false).then(()=>{seconds.value=60;const t=setInterval(()=>{seconds.value--;if(seconds.value<=0)clearInterval(t)},1000);uni.showToast({title:'验证码已发送',icon:'success'})}).catch(e=>{token.value='';uni.showToast({title:e.message||'发送失败',icon:'none'});load()}).finally(()=>busy.value=false)}
function login():void{if(!valid()||code.value.trim().length!=6){uni.showToast({title:'请输入手机号和 6 位验证码',icon:'none'});return};busy.value=true;appRequest('/auth/sms/login','POST',{mobile:mobile.value.trim(),code:code.value.trim(),channel:'h5'} as UTSJSONObject,false).then(d=>{setAccessToken((d['token'] as UTSJSONObject)['access_token'] as string);uni.showToast({title:'登录成功',icon:'success'});setTimeout(()=>uni.navigateBack(),300)}).catch(e=>uni.showToast({title:e.message||'登录失败',icon:'none'})).finally(()=>busy.value=false)}
onLoad(()=>load())
</script>
<template><view class="qx-page"><qx-nav title="短信登录"/><view class="qx-card form"><text class="title">短信验证码登录</text><input v-model="mobile" class="input" type="number" maxlength="11" placeholder="手机号"/><view class="row"><input v-model="answer" class="input grow" placeholder="图形验证码"/><image class="image" :src="image" mode="aspectFit" @click="load"/></view><button class="verify" @click="verify">{{token.length>0?'已完成安全验证':'验证图形码'}}</button><view class="row"><input v-model="code" class="input grow" type="number" maxlength="6" placeholder="短信验证码"/><button class="send" :disabled="seconds>0||busy" @click="send">{{seconds>0?seconds+' 秒':'发送验证码'}}</button></view><button class="qx-primary" :loading="busy" @click="login">登录</button></view></view></template>
<style>.form{margin-top:24px;display:flex;flex-direction:column;gap:14px}.title{font-size:20px;font-weight:700}.row{display:flex;gap:8px;align-items:center}.grow{min-width:0;flex:1}.input{height:46px;padding:0 12px;box-sizing:border-box;background:#f6f7f9;border-radius:8px}.image{width:108px;height:46px;border-radius:8px;background:#f6f7f9}.verify{height:36px;margin:0;color:#07a353;background:#ecfff2;border-radius:18px;font-size:13px}.send{width:104px;height:42px;margin:0;padding:0;color:#d72828;background:#fff3f1;border-radius:21px;font-size:12px;line-height:42px}.send:disabled{color:#86909c;background:#f2f3f5}.qx-primary{border-radius:22px}</style>
