<script setup lang="uts">
import { appRequest } from '../../common/request'
import { captchaGatewayURL } from '../../common/api'

const mobile = ref('')
const code = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const answer = ref('')
const image = ref('')
const challengeID = ref('')
const captchaToken = ref('')
const seconds = ref(0)
const busy = ref(false)

function captchaRequest(path: string, data: UTSJSONObject): Promise<UTSJSONObject> {
  return new Promise<UTSJSONObject>((resolve, reject) => {
    uni.request({
      url: captchaGatewayURL(path), method: 'POST', data: data,
      header: { 'Content-Type': 'application/json' } as UTSJSONObject,
      success: (response) => {
        const body = response.data as UTSJSONObject
        if (response.statusCode >= 200 && response.statusCode < 300) { resolve(body); return }
        reject(new Error(String(body['error'] || body['message'] || '安全验证失败')))
      },
      fail: () => reject(new Error('安全验证服务连接失败')),
    })
  })
}

function clientSignal(): UTSJSONObject {
  return { fingerprint: 'crm-reset-' + Date.now(), event_count: 1, duration_ms: 0, language: 'zh-CN' } as UTSJSONObject
}

function validMobile(): boolean { return /^1[3-9]\d{9}$/.test(mobile.value.trim()) }

function loadCaptcha(): void {
  captchaToken.value = ''
  answer.value = ''
  captchaRequest('/challenges', {
    action: 'login_sms', preferred_mode: 'image', locale: 'zh-CN', theme: 'light', client: clientSignal(),
  } as UTSJSONObject).then((data) => {
    challengeID.value = String(data['challenge_id'] || '')
    const encoded = String(data['image_png_base64'] || '')
    if (challengeID.value.length == 0 || encoded.length == 0) throw new Error('验证码加载失败')
    image.value = 'data:image/png;base64,' + encoded
  }).catch((error) => uni.showToast({ title: error.message || '加载失败', icon: 'none' }))
}

function verifyCaptcha(): void {
  if (challengeID.value.length == 0) { loadCaptcha(); return }
  if (answer.value.trim().length == 0) { uni.showToast({ title: '请输入图形验证码', icon: 'none' }); return }
  captchaRequest('/challenges/' + challengeID.value + '/verify', { answer: answer.value.trim(), client: clientSignal() } as UTSJSONObject).then((data) => {
    captchaToken.value = String(data['verification_token'] || '')
    if (captchaToken.value.length == 0) throw new Error('验证失败')
    uni.showToast({ title: '安全验证通过', icon: 'success' })
  }).catch((error) => { captchaToken.value = ''; uni.showToast({ title: error.message || '验证失败', icon: 'none' }); loadCaptcha() })
}

function sendCode(): void {
  if (!validMobile() || captchaToken.value.length == 0) {
    uni.showToast({ title: validMobile() ? '请先完成安全验证' : '请输入正确手机号', icon: 'none' }); return
  }
  busy.value = true
  appRequest('/auth/sms/send', 'POST', {
    mobile: mobile.value.trim(), purpose: 'reset_password', captcha_token: captchaToken.value,
  } as UTSJSONObject, false).then(() => {
    seconds.value = 60
    const timer = setInterval(() => { seconds.value--; if (seconds.value <= 0) clearInterval(timer) }, 1000)
    uni.showToast({ title: '验证码已发送', icon: 'success' })
  }).catch((error) => { captchaToken.value = ''; uni.showToast({ title: error.message || '发送失败', icon: 'none' }); loadCaptcha() }).finally(() => { busy.value = false })
}

function resetPassword(): void {
  if (!validMobile() || code.value.trim().length != 6) { uni.showToast({ title: '请输入手机号和 6 位验证码', icon: 'none' }); return }
  if (newPassword.value.length < 8) { uni.showToast({ title: '新密码至少 8 位', icon: 'none' }); return }
  if (newPassword.value != confirmPassword.value) { uni.showToast({ title: '两次输入的新密码不一致', icon: 'none' }); return }
  busy.value = true
  appRequest('/auth/password/reset', 'POST', {
    mobile: mobile.value.trim(), code: code.value.trim(), new_password: newPassword.value, confirm_password: confirmPassword.value,
  } as UTSJSONObject, false).then(() => {
    uni.showToast({ title: '密码已重置，请重新登录', icon: 'success' })
    setTimeout(() => uni.redirectTo({ url: '/pages/login/index' }), 500)
  }).catch((error) => uni.showToast({ title: error.message || '重置失败', icon: 'none' })).finally(() => { busy.value = false })
}

onLoad(() => loadCaptcha())
</script>

<template>
  <view class="qx-page">
    <qx-nav title="重置密码"/>
    <view class="qx-card form">
      <text class="title">短信验证重置密码</text>
      <text class="hint">为保障账号安全，请完成图形验证后获取短信验证码。</text>
      <input v-model="mobile" class="input" type="number" maxlength="11" placeholder="已绑定的手机号"/>
      <view class="row"><input v-model="answer" class="input grow" placeholder="图形验证码"/><image class="image" :src="image" mode="aspectFit" @click="loadCaptcha"/></view>
      <button class="verify" @click="verifyCaptcha">{{ captchaToken.length > 0 ? '已完成安全验证' : '验证图形码' }}</button>
      <view class="row"><input v-model="code" class="input grow" type="number" maxlength="6" placeholder="短信验证码"/><button class="send" :disabled="seconds > 0 || busy" @click="sendCode">{{ seconds > 0 ? seconds + ' 秒' : '发送验证码' }}</button></view>
      <input v-model="newPassword" class="input" password placeholder="新密码（至少 8 位）"/>
      <input v-model="confirmPassword" class="input" password placeholder="确认新密码"/>
      <button class="qx-primary" :loading="busy" @click="resetPassword">确认重置</button>
    </view>
  </view>
</template>

<style>
.form { margin-top:24px; display:flex; flex-direction:column; gap:14px; }
.title { font-size:20px; font-weight:700; }
.hint { color:#86909c; font-size:13px; line-height:20px; }
.row { display:flex; gap:8px; align-items:center; }.grow { min-width:0; flex:1; }
.input { height:46px; padding:0 12px; box-sizing:border-box; background:#f6f7f9; border-radius:8px; }
.image { width:108px; height:46px; border-radius:8px; background:#f6f7f9; }
.verify { height:36px; margin:0; color:#07a353; background:#ecfff2; border-radius:18px; font-size:13px; }
.send { width:104px; height:42px; margin:0; padding:0; color:#d72828; background:#fff3f1; border-radius:21px; font-size:12px; line-height:42px; }
.send:disabled { color:#86909c; background:#f2f3f5; }.qx-primary { border-radius:22px; }
</style>
