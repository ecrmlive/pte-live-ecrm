<script setup lang="uts">
import { clearSession, getAccessToken } from '../../common/session'
import { appRequest } from '../../common/request'

const loggedIn = ref(getAccessToken().length > 0)
type Profile = { nickname: string; mobile: string; channel: string }
const profile = ref<Profile | null>(null)

function loginOrLogout(): void {
  if (loggedIn.value) {
    clearSession()
    loggedIn.value = false
    profile.value = null
    return
  }
  uni.navigateTo({ url: '/pages/login/index' })
}

function go(path: string): void {
  if (!loggedIn.value) { uni.navigateTo({ url: '/pages/login/index' }); return }
  uni.navigateTo({ url: path })
}
function goPublic(path: string): void { uni.navigateTo({ url: path }) }
function profileAvatar(): string { const item = profile.value; return item == null || item.nickname.length == 0 ? 'C' : item.nickname.substring(0, 1) }
function profileName(): string { const item = profile.value; return loggedIn.value && item != null ? item.nickname : '未登录' }
function profileHint(): string { const item = profile.value; if (!loggedIn.value) return '登录后体验完整服务'; return item != null && item.mobile.length > 0 ? item.mobile : '查看订单、地址、权益与推广收入' }
function loadProfile(): void {
  if (!loggedIn.value) { profile.value = null; return }
  appRequest('/auth/me').then((data) => { profile.value = data as Profile }).catch(() => { clearSession(); loggedIn.value = false; profile.value = null })
}
onShow(() => { loggedIn.value = getAccessToken().length > 0; loadProfile() })
</script>

<template>
  <view class="qx-page"><qx-nav title="我的" /><view class="qx-card profile" @click="go('/pages/profile/edit')"><text class="avatar">{{ profileAvatar() }}</text><view><text class="name">{{ profileName() }}</text><text class="hint">{{ profileHint() }}</text></view></view><view class="qx-card"><view class="item" @click="go('/pages/profile/security')"><text>账户安全</text><text>›</text></view><view class="item danger" @click="go('/pages/profile/cancel')"><text>注销账户</text><text>›</text></view><view class="item" @click="go('/pages/notification/list')"><text>消息通知</text><text>›</text></view><view class="item" @click="go('/pages/account/balance')"><text>我的余额</text><text>›</text></view><view class="item" @click="go('/pages/account/points')"><text>我的积分</text><text>›</text></view><view class="item" @click="go('/pages/member/index')"><text>会员中心</text><text>›</text></view><view class="item" @click="go('/pages/sign/index')"><text>每日签到</text><text>›</text></view><view class="item" @click="go('/pages/merchant/apply')"><text>商户入驻</text><text>›</text></view><view class="item" @click="go('/pages/order/list')"><text>我的订单</text><text>›</text></view><view class="item" @click="go('/pages/address/list')"><text>收货地址</text><text>›</text></view><view class="item" @click="go('/pages/history/list')"><text>浏览记录</text><text>›</text></view><view class="item" @click="go('/pages/favorite/list')"><text>我的收藏</text><text>›</text></view><view class="item" @click="go('/pages/coupon/mine')"><text>我的优惠券</text><text>›</text></view><view class="item" @click="go('/pages/points/list')"><text>积分商城</text><text>›</text></view><view class="item" @click="go('/pages/spread/index')"><text>分销中心</text><text>›</text></view><view class="item" @click="go('/pages/refund/list')"><text>售后服务</text><text>›</text></view><view class="item" @click="go('/pages/feedback/index')"><text>意见反馈</text><text>›</text></view><view class="item" @click="go('/pages/invoice/list')"><text>我的发票</text><text>›</text></view><view class="item" @click="go('/pages/comment/list')"><text>我的评价</text><text>›</text></view><view class="item" @click="go('/pages/community/mine')"><text>我的发布</text><text>›</text></view></view><view class="qx-card"><view class="item" @click="goPublic('/pages/notice/list')"><text>平台公告</text><text>›</text></view><view class="item" @click="goPublic('/pages/article/list')"><text>商城资讯</text><text>›</text></view><view class="item" @click="goPublic('/pages/community/list')"><text>社区广场</text><text>›</text></view><view class="item" @click="goPublic('/pages/agreement/detail?key=sys_user_agree')"><text>用户协议</text><text>›</text></view><view class="item" @click="goPublic('/pages/agreement/detail?key=sys_userr_privacy')"><text>隐私政策</text><text>›</text></view><view class="item" @click="goPublic('/pages/agreement/detail?key=sys_about_us')"><text>关于我们</text><text>›</text></view></view><view class="qx-card"><button class="qx-primary" @click="loginOrLogout">{{ loggedIn ? '退出登录' : '登录 / 注册' }}</button></view></view>
</template>

<style>.profile { display: flex; align-items: center; gap: 12px; }.avatar { width: 48px; height: 48px; border-radius: 24px; color: #ffffff; background-color: #d72828; text-align: center; line-height: 48px; font-size: 20px; }.name { display: block; font-size: 17px; font-weight: 600; }.hint { display: block; margin-top: 6px; color: #86909c; font-size: 13px; }.item { height: 52px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; justify-content: space-between; }.danger { color: #d72828; }.qx-primary { border-radius: 22px; font-size: 15px; }</style>
