<script setup lang="uts">
import { appRequest } from '../../common/request'
import { captchaGatewayURL } from '../../common/api'

const mobile = ref('')
const code = ref('')
const boundMobile = ref('')
const captchaID = ref('')
const captchaImage = ref('')
const captchaAnswer = ref('')
const captchaToken = ref('')
const sending = ref(false)
const binding = ref(false)
const captchaLoading = ref(false)
const countdown = ref(0)

function validMobile(): boolean { return /^1[3-9]\d{9}$/.test(mobile.value.trim()) }
function captchaRequest(path: string, data: UTSJSONObject): Promise<UTSJSONObject> { return new Promise<UTSJSONObject>((resolve,reject)=>{ uni.request({url:captchaGatewayURL(path),method:'POST',data:data,header:{'Content-Type':'application/json'} as UTSJSONObject,success:(res)=>{const body=res.data as UTSJSONObject;if(res.statusCode>=200&&res.statusCode<300){resolve(body);return};reject(new Error(String(body['error']||'安全验证服务暂不可用')))},fail:()=>reject(new Error('安全验证服务连接失败'))}) }) }
function loadCaptcha(): void { if(captchaLoading.value)return;captchaLoading.value=true;captchaToken.value='';captchaAnswer.value='';captchaRequest('/challenges',{action:'login_sms',preferred_mode:'image',locale:'zh-CN',theme:'light',client:{fingerprint:'crm-mobile-'+Date.now(),event_count:1,duration_ms:0,language:'zh-CN'} as UTSJSONObject} as UTSJSONObject).then((data)=>{const id=String(data['challenge_id']||'');const image=String(data['image_png_base64']||'');if(id.length==0||image.length==0)throw new Error('验证码加载失败');captchaID.value=id;captchaImage.value='data:image/png;base64,'+image}).catch((error)=>uni.showToast({title:error.message||'验证码加载失败',icon:'none'})).finally(()=>captchaLoading.value=false) }
function verifyCaptcha(): void { if(captchaID.value.length==0){loadCaptcha();return};if(captchaAnswer.value.trim().length==0){uni.showToast({title:'请输入图形验证码',icon:'none'});return};captchaLoading.value=true;captchaRequest('/challenges/'+captchaID.value+'/verify',{answer:captchaAnswer.value.trim(),client:{fingerprint:'crm-mobile-'+Date.now(),event_count:1,duration_ms:0,language:'zh-CN'} as UTSJSONObject} as UTSJSONObject).then((data)=>{const token=String(data['verification_token']||'');if(String(data['status']||'')!='verified'||token.length==0)throw new Error('验证失败');captchaToken.value=token;uni.showToast({title:'安全验证通过',icon:'success'})}).catch((error)=>{captchaToken.value='';uni.showToast({title:error.message||'验证失败',icon:'none'});loadCaptcha()}).finally(()=>captchaLoading.value=false) }
function startCountdown(): void { countdown.value=60; const timer=setInterval(()=>{countdown.value--;if(countdown.value<=0)clearInterval(timer)},1000) }
function sendCode(): void { if(!validMobile()){uni.showToast({title:'请输入正确的手机号',icon:'none'});return};if(captchaToken.value.length==0){uni.showToast({title:'请先完成安全验证',icon:'none'});return};sending.value=true;appRequest('/auth/sms/send','POST',{mobile:mobile.value.trim(),purpose:'binding',captcha_token:captchaToken.value} as UTSJSONObject,false).then(()=>{uni.showToast({title:'验证码已发送',icon:'success'});startCountdown()}).catch((error)=>{captchaToken.value='';uni.showToast({title:error.message||'发送失败',icon:'none'});loadCaptcha()}).finally(()=>sending.value=false) }
function bind(): void { if(!validMobile()||code.value.trim().length!=6){uni.showToast({title:'请输入手机号和 6 位验证码',icon:'none'});return};binding.value=true;appRequest('/auth/mobile/bind','POST',{mobile:mobile.value.trim(),code:code.value.trim()} as UTSJSONObject).then(()=>{uni.showToast({title:'手机号绑定成功',icon:'success'});setTimeout(()=>uni.navigateBack(),300)}).catch((error)=>uni.showToast({title:error.message||'绑定失败',icon:'none'})).finally(()=>binding.value=false) }
function load(): void { appRequest('/auth/me').then((data)=>{boundMobile.value=String((data as UTSJSONObject)['mobile']||'')}).catch(()=>{}) }
onLoad(()=>{load();loadCaptcha()})
</script>

<template><view class="qx-page"><qx-nav title="绑定手机号"/><view v-if="boundMobile.length>0" class="qx-card bound"><text class="title">已绑定手机号</text><text class="number">{{boundMobile}}</text><text class="hint">为保障账户安全，换绑需通过独立安全流程。</text><button class="qx-primary" @click="uni.navigateTo({url:'/pages/profile/mobile-change'})">更换手机号</button></view><view v-else class="qx-card form"><text class="title">绑定手机号</text><text class="hint">绑定后可用于账号安全校验与重要通知。</text><input v-model="mobile" class="input" type="number" maxlength="11" placeholder="请输入手机号"/><view class="captcha-row"><input v-model="captchaAnswer" class="input captcha-input" maxlength="8" placeholder="图形验证码"/><image v-if="captchaImage.length>0" class="captcha-image" :src="captchaImage" mode="aspectFit" @click="loadCaptcha"/></view><button class="verify" :loading="captchaLoading" @click="verifyCaptcha">{{captchaToken.length>0?'已完成安全验证':'验证图形码'}}</button><view class="code-row"><input v-model="code" class="input code-input" type="number" maxlength="6" placeholder="短信验证码"/><button class="send" :disabled="countdown>0||sending" :loading="sending" @click="sendCode">{{countdown>0?countdown+' 秒':'发送验证码'}}</button></view><button class="qx-primary" :loading="binding" @click="bind">确认绑定</button></view></view></template>
<style>.form,.bound{margin-top:18px;display:flex;flex-direction:column;gap:13px}.title{font-size:19px;font-weight:700}.hint{color:#86909c;font-size:12px;line-height:18px}.number{color:#1f2329;font-size:18px;font-weight:600}.input{height:46px;padding:0 12px;box-sizing:border-box;background:#f6f7f9;border-radius:8px}.captcha-row,.code-row{display:flex;align-items:center;gap:9px}.captcha-input,.code-input{min-width:0;flex:1}.captcha-image{width:110px;height:46px;border-radius:8px;background:#f6f7f9}.verify{height:36px;margin:0;color:#07a353;background:#ecfff2;border-radius:18px;font-size:13px}.send{width:104px;height:42px;margin:0;padding:0;color:#d72828;background:#fff3f1;border-radius:21px;font-size:12px;line-height:42px}.send:disabled{color:#86909c;background:#f2f3f5}.qx-primary{margin-top:6px;border-radius:22px}</style>
