<script setup lang="uts">
import { appRequest } from '../../common/request'

type Product = { product_id: number; store_name: string; mer_name: string; price: number; show_reservation_days: number }
type ProductPage = { list: Product[]; total: number; page: number; limit: number }
const items = ref<Product[]>([])
const loading = ref(false)
const page = ref(1)
const total = ref(0)
const limit = 20
function hasMore(): boolean { return items.value.length < total.value }
function load(reset: boolean = false): void { if (loading.value || (!reset && !hasMore())) return; const next = reset ? 1 : page.value + 1; loading.value = true; appRequest(`/reservation/products?page=${next}&limit=${limit}`, 'GET', null, false).then((data) => { const result = data as ProductPage; page.value = result.page || next; total.value = result.total || 0; items.value = reset ? (result.list || []) : items.value.concat(result.list || []) }).catch((error) => uni.showToast({ title: error.message || '预约服务加载失败', icon: 'none' })).finally(() => { loading.value = false }) }
function detail(id: number): void { uni.navigateTo({ url: `/pages/reservation/detail?id=${id}` }) }
onShow(() => load(true))
onReachBottom(() => load())
</script>
<template><view class="qx-page"><qx-nav title="预约服务" /><view class="tip">选择服务日期和时段，支付后凭订单核销码到店使用。</view><view v-if="items.length == 0 && !loading" class="qx-card empty">暂无可预约服务</view><view v-for="item in items" :key="item.product_id" class="qx-card item" @click="detail(item.product_id)"><text class="name">{{ item.store_name }}</text><text class="sub">{{ item.mer_name }} · 可预约 {{ item.show_reservation_days }} 天</text><text class="price">¥{{ item.price }}</text></view><view v-if="items.length > 0" class="more">{{ loading ? '正在加载…' : (hasMore() ? '上拉加载更多' : '已经到底了') }}</view></view></template>
<style>.tip { padding: 12px; color: #86909c; font-size: 13px; }.empty { color: #86909c; text-align: center; }.name,.sub,.price { display:block; }.name { font-size:16px;font-weight:600; }.sub { margin-top:7px;color:#86909c;font-size:12px; }.price { margin-top:10px;color:#d72828;font-size:19px;font-weight:700; }.more { padding:16px 0 28px;color:#86909c;text-align:center;font-size:13px; }</style>
