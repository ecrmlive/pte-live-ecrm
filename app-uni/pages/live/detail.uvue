<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
type Goods={product_id:number;store_name:string;price:number;on_sale:number};type Reservation={reserved:boolean};type Room={broadcast_room_id:number;name:string;mer_name:string;anchor_name:string;cover_img:string;live_status:number;play_url:string;goods:Goods[]};const item=ref<Room|null>(null);const reserved=ref(false);const reserving=ref(false)
function hasRoom(): boolean { return item.value != null }
function roomName(): string { const room = item.value; return room == null ? '直播间加载中' : room.name }
function roomDescription(): string { const room = item.value; return room == null ? '直播间信息加载中' : room.mer_name + ' · 主播 ' + (room.anchor_name.length == 0 ? '-' : room.anchor_name) + ' · ' + label(room.live_status) }
function canReserve(): boolean { const room = item.value; return room != null && room.live_status != 103 }
function isLive(): boolean { const room = item.value; return room != null && room.live_status == 101 }
function livePlayURL(): string { const room = item.value; return room == null ? '-' : room.play_url }
function liveCover(): string { const room = item.value; return room == null ? '-' : room.cover_img }
function playerHint(): string { return isLive() ? '直播播放地址暂未配置' : '直播尚未开始或已结束' }
function roomGoods(): Goods[] { const room = item.value; return room == null ? [] : room.goods }
function goodsEmpty(): boolean { return roomGoods().length == 0 }
function label(status:number):string{if(status==101)return '直播中';if(status==103)return '已结束';return '未开始'} function reservation():void{if(item.value==null)return;if(getAccessToken().length==0){uni.navigateTo({url:'/pages/login/index'});return};reserving.value=true;appRequest('/live/rooms/'+item.value.broadcast_room_id+'/reservation',reserved.value?'DELETE':'POST').then((data)=>reserved.value=(data as Reservation).reserved).catch((error)=>uni.showToast({title:error.message||'操作失败',icon:'none'})).finally(()=>reserving.value=false)} function goods(id:number):void{uni.navigateTo({url:`/pages/goods/detail?id=${id}`})}
onLoad((query)=>{const id=Number(query?.["id"]||0);if(id>0)appRequest("/live/rooms/"+id,"GET",null,false).then((data)=>{item.value=data as Room;if(getAccessToken().length>0)appRequest("/live/rooms/"+id+"/reservation").then((status)=>reserved.value=(status as Reservation).reserved).catch(()=>reserved.value=false)}).catch((error)=>uni.showToast({title:error.message||"直播间加载失败",icon:"none"}))})
</script>
<template><view class="qx-page"><qx-nav title="直播详情"/><view v-if="hasRoom()" class="hero"><text class="name">{{roomName()}}</text><text class="sub">{{roomDescription()}}</text><button v-if="canReserve()" :loading="reserving" class="reserve" @click="reservation">{{reserved?'取消预约':'预约直播'}}</button></view><view v-if="hasRoom()" class="player"><video v-if="isLive() && livePlayURL() != '-'" :poster="liveCover()" :src="livePlayURL()" controls autoplay></video><text v-else>{{playerHint()}}</text></view><view v-if="hasRoom()" class="qx-card"><text class="name">直播间商品</text><text v-if="goodsEmpty()" class="sub">暂无挂载商品</text><view v-for="goodsItem in roomGoods()" :key="goodsItem.product_id" class="goods" @click="goods(goodsItem.product_id)"><text>{{goodsItem.store_name||`商品 #${goodsItem.product_id}`}}</text><text class="price">¥{{goodsItem.price}} ›</text></view></view></view></template>
<style>.hero{margin:12px;padding:20px;color:#fff;background:linear-gradient(135deg,#312b50,#7566a9);border-radius:12px}.reserve{margin:0 12px;color:#fff;background:#d72828;border-radius:20px;font-size:14px}.player{height:220px;margin:12px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#111;color:#d9d9d9;font-size:14px;overflow:hidden}.player video{width:100%;height:100%;background:#000}.name,.sub,.price{display:block}.name{font-size:17px;font-weight:600}.hero .name{font-size:21px}.sub{margin-top:9px;color:#86909c;font-size:13px}.hero .sub{color:#eee}.goods{display:flex;justify-content:space-between;margin-top:12px;padding-top:12px;border-top:1px solid #f0f0f0;color:#4e5969;font-size:14px}.price{color:#d72828;font-weight:600}</style>
