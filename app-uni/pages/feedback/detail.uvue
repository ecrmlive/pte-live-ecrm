<script setup lang="uts">
import { appRequest } from '../../common/request'
type Feedback = { feedback_id:number; type:string; content:string; status:string; reply:string; create_time:string; update_time:string }
const id=ref(0); const item=ref<Feedback|null>(null)
function hasFeedback(): boolean { return item.value != null }
function feedbackStatus(): string { const feedback = item.value; return feedback == null ? '待处理' : statusText(feedback.status) }
function feedbackType(): string { const feedback = item.value; return feedback == null ? '--' : feedback.type }
function feedbackContent(): string { const feedback = item.value; return feedback == null ? '--' : feedback.content }
function feedbackReply(): string { const feedback = item.value; return feedback == null ? '-' : feedback.reply }
function hasFeedbackReply(): boolean { return feedbackReply().length > 0 }
function feedbackTime(): string { const feedback = item.value; return feedback == null ? '--' : feedback.create_time }
function statusText(value:string):string{if(value=='resolved')return '已处理';if(value=='rejected')return '未采纳';if(value=='processing')return '处理中';return '待处理'}
function load():void{if(id.value>0)appRequest('/feedback/detail/'+id.value).then((data)=>{item.value=data as Feedback}).catch((error)=>uni.showToast({title:error.message||'加载失败',icon:'none'}))}
onLoad((query)=>{id.value=Number(query?.['id']||0);load()})
</script>
<template><view v-if="hasFeedback()" class="qx-page"><qx-nav title="反馈详情"/><view class="qx-card"><text class="status">{{feedbackStatus()}}</text><text class="line">类型：{{feedbackType()}}</text><text class="line">内容：{{feedbackContent()}}</text><text v-if="hasFeedbackReply()" class="reply">处理回复：{{feedbackReply()}}</text><text class="time">提交于 {{feedbackTime()}}</text></view></view></template>
<style>.status,.line,.reply,.time{display:block}.status{color:#d72828;font-size:19px;font-weight:700}.line,.reply{margin-top:14px;color:#4e5969;line-height:21px}.reply{color:#00b42a}.time{margin-top:18px;color:#86909c;font-size:12px}</style>
