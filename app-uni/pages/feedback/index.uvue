<script setup lang="uts">
import { appRequest } from "../../common/request"
type Feedback = { feedback_id:number; type:string; content:string; status:string; create_time:string }
type Page = { list:Feedback[]; total:number; page:number; limit:number }
const types = ["功能建议", "商品问题", "订单问题", "其他"]
const type = ref("功能建议")
const content = ref("")
const items = ref<Feedback[]>([])
const page = ref(1)
const total = ref(0)
const loading = ref(false)
const submitting = ref(false)
function statusText(value:string):string { if (value=="resolved") return "已处理"; if (value=="rejected") return "未采纳"; if (value=="processing") return "处理中"; return "待处理" }
function hasMore():boolean { return items.value.length < total.value }
function load(reset:boolean = false):void { if (loading.value || (!reset && total.value>0 && !hasMore())) return; if (reset) { items.value=[];page.value=1;total.value=0 };loading.value=true;appRequest("/feedback/list?page="+page.value+"&limit=20").then((data)=>{const result=data as Page;items.value=items.value.concat(result.list||[]);total.value=result.total||0;page.value+=1}).catch((error)=>uni.showToast({title:error.message||"反馈加载失败",icon:"none"})).finally(()=>loading.value=false) }
function submit():void { if (content.value.trim().length==0) { uni.showToast({title:"请填写反馈内容",icon:"none"});return };submitting.value=true;appRequest("/feedback","POST",{type:type.value,content:content.value.trim()} as UTSJSONObject).then(()=>{content.value="";uni.showToast({title:"已提交，感谢反馈",icon:"success"});load(true)}).catch((error)=>uni.showToast({title:error.message||"提交失败",icon:"none"})).finally(()=>submitting.value=false) }
function detail(id:number):void { uni.navigateTo({url:"/pages/feedback/detail?id="+id}) }
onShow(()=>load(true))
onReachBottom(()=>load())
</script><template><view class="qx-page"><qx-nav title="意见反馈"/><view class="qx-card"><picker :range="types" @change="(event)=>type=types[Number(event.detail.value)]"><view class="field">反馈类型：{{type}} ›</view></picker><textarea v-model="content" class="input" maxlength="1000" placeholder="请描述您遇到的问题或建议"/><button :loading="submitting" class="qx-primary" @click="submit">提交反馈</button></view><view class="heading">我的反馈</view><view v-if="!loading&&items.length==0" class="qx-card empty">暂无反馈记录</view><view v-for="item in items" :key="item.feedback_id" class="qx-card record" @click="detail(item.feedback_id)"><text>{{item.type}} · {{statusText(item.status)}}</text><text>{{item.content}}</text><text>{{item.create_time}}</text></view><text v-if="loading" class="more">加载中...</text><text v-else-if="items.length>0&&!hasMore()" class="more">没有更多了</text><text v-else-if="items.length>0" class="more" @click="load()">加载更多</text></view></template><style>.field{height:44px;line-height:44px;color:#4e5969}.input{width:100%;height:120px;padding:10px;box-sizing:border-box;background:#f6f7f9;border-radius:8px}.qx-primary{margin-top:12px;border-radius:22px}.heading{padding:14px;color:#1f2329;font-size:16px;font-weight:600}.empty,.more{display:block;color:#86909c;text-align:center}.empty{padding:22px}.more{padding:16px;font-size:12px}.record text{display:block}.record text:nth-child(2){margin-top:8px;color:#4e5969}.record text:last-child{margin-top:8px;color:#86909c;font-size:12px}</style>