<script setup lang="uts">
import { appRequest } from "../../common/request"
import { uploadMerchantLicense } from "../../common/merchant-license-upload"
type Application={id:number;merchant_name:string;status:string;created_at:string};type ApplicationPage={list:Application[];total:number;page:number;limit:number};const applications=ref<Application[]>([]);const applicationPage=ref(1);const applicationTotal=ref(0);const applicationLoading=ref(false);const applicationLimit=20;
function statusText(value:string):string{return value=="approved"?"已通过":value=="rejected"?"已驳回":"审核中"}
function loadApplications(reset:boolean=false):void{if(applicationLoading.value)return;if(!reset&&applicationTotal.value>0&&applications.value.length>=applicationTotal.value)return;const next=reset?1:applicationPage.value+1;applicationLoading.value=true;appRequest("/merchant-applications/mine?page="+next+"&limit="+applicationLimit).then((data)=>{const result=data as ApplicationPage;applicationPage.value=result.page||next;applicationTotal.value=result.total||0;applications.value=reset?(result.list||[]):applications.value.concat(result.list||[])}).catch(()=>{if(reset)applications.value=[]}).finally(()=>applicationLoading.value=false)}
const merchantName=ref("");const contactName=ref("");const contactMobile=ref("");const categoryName=ref("");const merchantType=ref("企业店");const licenseKey=ref("");const licenseName=ref("未选择营业执照");const uploading=ref(false);const saving=ref(false)
function choose():void{
 // #ifdef WEB
 uni.chooseFile({count:1,type:"image",success:(result:any)=>{const file=result.tempFiles[0];const path=String(file.path??result.tempFilePaths[0]);const name=String(file.name??"营业执照.jpg");const type=String(file.type??"image/jpeg");const size=Number(file.size??0);uploading.value=true;uploadMerchantLicense(path,name,type,size).then((key)=>{licenseKey.value=key;licenseName.value=name;uni.showToast({title:"执照已上传",icon:"success"})}).catch((error)=>uni.showToast({title:error.message||"上传失败",icon:"none"})).finally(()=>uploading.value=false)}})
 // #endif
}
function submit():void{if(!licenseKey.value){uni.showToast({title:"请先上传营业执照",icon:"none"});return};saving.value=true;appRequest("/merchant-applications","POST",{merchant_name:merchantName.value.trim(),contact_name:contactName.value.trim(),contact_mobile:contactMobile.value.trim(),category_name:categoryName.value.trim(),merchant_type:merchantType.value,license_key:licenseKey.value} as UTSJSONObject).then(()=>{uni.showToast({title:"申请已提交，等待审核",icon:"success"});licenseKey.value="";licenseName.value="未选择营业执照";loadApplications(true)}).catch((error)=>uni.showToast({title:error.message||"提交失败",icon:"none"})).finally(()=>saving.value=false)}
onShow(()=>loadApplications(true))
onReachBottom(()=>loadApplications())
</script><template><view class="qx-page"><qx-nav title="商户入驻"/><view class="qx-card"><input v-model="merchantName" class="input" placeholder="商户名称"/><input v-model="contactName" class="input" placeholder="联系人姓名"/><input v-model="contactMobile" class="input" placeholder="联系电话"/><input v-model="categoryName" class="input" placeholder="经营类目，如：服饰鞋包"/><picker :range="['企业店','个体工商户']" @change="(event)=>merchantType=event.detail.value==0?'企业店':'个体工商户'"><view class="input">商户类型：{{merchantType}} ›</view></picker><button :loading="uploading" class="license" @click="choose">营业执照：{{licenseName}}</button><button :loading="saving" class="qx-primary" @click="submit">提交入驻申请</button></view><view v-if="applications.length>0" class="records"><text class="records-title">我的申请记录</text><view v-for="item in applications" :key="item.id" class="record" @click="uni.navigateTo({url:'/pages/merchant/application-detail?id='+item.id})"><text>{{item.merchant_name}}</text><text class="status">{{statusText(item.status)}}</text><text class="record-time">{{item.created_at}}</text></view></view></view></template><style>.input{height:44px;margin-bottom:12px;padding:0 10px;box-sizing:border-box;line-height:44px;background:#f6f7f9;border-radius:8px}.license{overflow:hidden;margin:0 0 16px;text-align:left;color:#4e5969;background:#fff;border:1px dashed #86909c;font-size:13px}.qx-primary{border-radius:22px}.records{margin:12px}.records-title{display:block;margin-bottom:8px;color:#4e5969;font-size:14px;font-weight:600}.record{margin-top:8px;padding:12px;background:#fff;border-radius:8px}.record:active{opacity:.72}.record text{display:block}.status{margin-top:6px;color:#d72828}.record-time{margin-top:5px;color:#86909c;font-size:12px}</style>