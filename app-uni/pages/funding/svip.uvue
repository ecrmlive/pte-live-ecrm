<script setup lang="uts">
import { appRequest } from '../../common/request'

type Plan={id:number;name:string;price:number;plan_type:string;duration_days:number|null;benefits:string;purchasable:boolean}
type Status={active:boolean;status:string;expires_at:string|null}
type Order={id:number;order_no:string;plan_name:string;amount:number;status:string}
type Intent={status:string;payment_mode:string;mweb_url:string}
const plans=ref<Plan[]>([]);const status=ref<Status>({active:false,status:'',expires_at:null});const selected=ref(0);const order=ref<Order|null>(null);const submitting=ref(false)
function load():void{appRequest('/funding/svip-plans').then((data)=>plans.value=(data['list'] as Plan[])||[]).catch((error)=>uni.showToast({title:error.message||'SVIP 方案加载失败',icon:'none'}));appRequest('/funding/svip-status').then((data)=>status.value=data as Status).catch(()=>{})}
function label(item:Plan):string{if(item.plan_type=='lifetime')return '永久有效';if(item.plan_type=='trial')return '体验 '+String(item.duration_days||0)+' 天';return String(item.duration_days||0)+' 天权益'}
function key():string{return 'svip-'+Date.now().toString()+'-'+Math.floor(Math.random()*1000000).toString()}
function submit():void{if(submitting.value||selected.value==0)return;const plan=plans.value.find((item)=>item.id==selected.value);if(plan==null||!plan.purchasable){uni.showToast({title:'该方案暂不可购买',icon:'none'});return};submitting.value=true;appRequest('/funding/svip-orders','POST',{plan_id:plan.id,idempotency_key:key()} as UTSJSONObject).then((data)=>{order.value=data as Order;return appRequest('/funding/svip-orders/'+order.value.id+'/pay','POST',{} as UTSJSONObject)}).then((data)=>openWechat(data as Intent)).catch((error)=>uni.showToast({title:error.message||'开通 SVIP 失败',icon:'none'})).finally(()=>submitting.value=false)}
function refresh():void{if(order.value==null)return;appRequest('/funding/svip-orders/'+order.value.id).then((data)=>{order.value=data as Order;if(order.value.status=='paid'){uni.showToast({title:'SVIP 已生效',icon:'success'});load()}}).catch((error)=>uni.showToast({title:error.message||'权益状态查询失败',icon:'none'}))}
function currentNo():string{return order.value==null?'':order.value.order_no}
function paid():boolean{return order.value!=null&&order.value.status=='paid'}
function openWechat(intent:Intent):void{
  const raw=String(intent.mweb_url||'')
  if(intent.status=='paid'){refresh();return}
  if(intent.payment_mode!='mweb'||raw.length==0){uni.showToast({title:'微信支付链接无效',icon:'none'});return}
  // #ifdef H5
  const browser:any=globalThis as any
  const location=browser.location
  if(location==null||typeof location.assign!='function'){uni.showToast({title:'当前浏览器无法发起微信 H5 支付',icon:'none'});return}
  const redirect=String(location.origin||'')+'/#/pages/funding/svip'
  location.assign(raw+(raw.indexOf('?')>=0?'&':'?')+'redirect_url='+encodeURIComponent(redirect))
  // #endif
  // #ifndef H5
  uni.showToast({title:'请在微信浏览器中完成支付',icon:'none'})
  // #endif
}
onShow(()=>{load();refresh()})
</script>

<template><view class="qx-page"><qx-nav title="SVIP 权益"/><view class="hero"><text class="caption">CRM Live SVIP</text><text class="title">{{status.active?'权益已生效':'开通后享受会员专属价格与服务'}}</text><text v-if="status.active&&status.expires_at!=null" class="expiry">有效期至 {{status.expires_at}}</text><text v-else-if="status.status=='lifetime'" class="expiry">永久有效</text></view><view class="section">选择开通方案</view><view v-for="item in plans" :key="item.id" :class="selected==item.id&&item.purchasable?'qx-card plan selected':'qx-card plan'" @click="item.purchasable?selected=item.id:null"><view><text class="name">{{item.name}}</text><text class="meta">{{label(item)}}</text></view><view><text class="price">¥{{item.price}}</text><text v-if="!item.purchasable" class="used">已体验</text></view></view><view v-if="plans.length==0" class="qx-card empty">暂无可购买的 SVIP 方案</view><view v-if="order!=null" class="qx-card result"><text>开通单：{{currentNo()}}</text><text>状态：{{paid()?'已生效':'待支付'}}</text><text v-if="!paid()" class="refresh" @click="refresh">支付完成后点此刷新</text></view><text class="agreement" @click="uni.navigateTo({url:'/pages/agreement/detail?key=sys_svip'})">开通即表示同意《付费会员协议》</text><view class="footer"><button class="qx-primary" :loading="submitting" :disabled="selected==0" @click="submit">微信开通 SVIP</button></view></view></template>

<style>.hero{padding:25px 18px;color:#fff;background:linear-gradient(135deg,#3d2c64,#7557ab)}.caption,.title,.expiry,.name,.meta,.price,.used,.result text{display:block}.caption{font-size:13px;opacity:.8}.title{margin-top:8px;font-size:19px;font-weight:700}.expiry{margin-top:8px;font-size:12px;opacity:.85}.section{padding:14px;color:#4e5969;font-size:14px;font-weight:600}.plan{display:flex;align-items:center;justify-content:space-between;margin-top:8px}.selected{border:1px solid #7657ac;background:#f6f1ff}.name{font-weight:600}.meta,.used{margin-top:5px;color:#86909c;font-size:12px}.price{color:#7353aa;font-size:21px;font-weight:700;text-align:right}.used{color:#d72828}.empty,.result{color:#86909c;text-align:center}.result{text-align:left;margin-top:12px}.result text+text{margin-top:7px}.refresh{color:#7353aa}.agreement{display:block;margin:16px 12px 0;color:#86909c;text-align:center;font-size:12px}.footer{padding:12px 12px 20px}</style>
