<script setup lang="uts">
import { appRequest } from '../../common/request'
const orderItemID=ref(0);const score=ref(5);const content=ref('');const saving=ref(false)
function submit():void{if(orderItemID.value==0||content.value.trim().length==0){uni.showToast({title:'请填写评价内容',icon:'none'});return};saving.value=true;appRequest('/comments','POST',{order_item_id:orderItemID.value,score:score.value,content:content.value.trim()} as UTSJSONObject).then(()=>{uni.showToast({title:'评价已提交，审核后展示',icon:'success'});setTimeout(()=>uni.navigateBack(),700)}).catch((error)=>uni.showToast({title:error.message||'提交失败',icon:'none'})).finally(()=>{saving.value=false})}
onLoad((query)=>{orderItemID.value=Number(query?.['order_item_id']||0)})
</script>
<template><view class="qx-page"><qx-nav title="评价商品"/><view class="qx-card"><picker :range="[1,2,3,4,5]" @change="(event)=>score=Number(event.detail.value)+1"><view class="field">评分：{{score}} 星 ›</view></picker><textarea v-model="content" class="input" maxlength="2000" placeholder="分享商品使用感受，文明评价更有帮助"/><button :loading="saving" class="qx-primary" @click="submit">提交评价</button></view></view></template>
<style>.field{height:44px;line-height:44px;color:#4e5969}.input{width:100%;height:150px;padding:10px;box-sizing:border-box;background:#f6f7f9;border-radius:8px}.qx-primary{margin-top:12px;border-radius:22px}</style>
