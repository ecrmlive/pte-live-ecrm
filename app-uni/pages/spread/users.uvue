<script setup lang="uts">
import { appRequest } from '../../common/request'

type DirectUser = { nickname: string; bound_at: string }
type UserPage = { list: DirectUser[]; total: number; page: number; limit: number }

const list = ref<DirectUser[]>([])
const total = ref(0)
const page = ref(1)
const loading = ref(false)
const hasMore = computed((): boolean => list.value.length < total.value)

function load(reset: boolean = false): void {
  if (loading.value || (!reset && !hasMore.value && total.value > 0)) return
  if (reset) { page.value = 1; list.value = [] }
  loading.value = true
  appRequest('/spread/users?page=' + page.value + '&limit=20').then((data) => {
    const result = data as UserPage
    list.value = list.value.concat(result.list || [])
    total.value = result.total || 0
    page.value += 1
  }).catch((error) => uni.showToast({ title: error.message || '推广用户加载失败', icon: 'none' })).finally(() => { loading.value = false })
}

onShow(() => load(true))
onReachBottom(() => load())
</script>

<template>
  <view class="qx-page"><qx-nav title="直属推广用户" /><view class="qx-card"><text class="summary">直属推广用户 {{ total }} 人</text><view v-if="list.length == 0 && !loading" class="empty">暂无直属推广用户</view><view v-for="(item, index) in list" :key="index" class="row"><view class="avatar"><text>{{ item.nickname.substring(0, 1) }}</text></view><view><text class="row__name">{{ item.nickname }}</text><text class="row__time">绑定时间：{{ item.bound_at }}</text></view></view><text v-if="loading" class="more">加载中...</text><text v-else-if="list.length > 0 && !hasMore" class="more">没有更多了</text></view></view>
</template>

<style>
.summary { display: block; padding-bottom: 12px; color: #303133; font-size: 16px; font-weight: 600; border-bottom: 1px solid #f0f0f0; }.row { display: flex; align-items: center; padding: 14px 0; border-bottom: 1px solid #f6f6f6; }.avatar { display: flex; width: 38px; height: 38px; margin-right: 12px; align-items: center; justify-content: center; color: #d72828; background-color: #fff0f0; border-radius: 19px; font-size: 16px; font-weight: 600; }.row__name, .row__time { display: block; }.row__name { color: #303133; font-size: 15px; }.row__time, .empty, .more { color: #86909c; font-size: 12px; }.row__time { margin-top: 5px; }.empty, .more { display: block; padding: 28px 0; text-align: center; }.more { padding: 14px 0 0; }
</style>
