<script setup lang="uts">
import { appRequest } from '../../common/request'

type Presell = { product_presell_id: number; store_name: string; mer_name: string; price: number; down_price: number; final_price: number; presell_type: number; stock: number }
type PresellPage = { list: Presell[]; total: number; page: number; limit: number }
const items = ref<Presell[]>([])
const loading = ref(false)
const page = ref(1)
const total = ref(0)
const limit = 20
function hasMore(): boolean { return items.value.length < total.value }
function load(reset: boolean = false): void { if (loading.value || (!reset && !hasMore())) return; const next = reset ? 1 : page.value + 1; loading.value = true; appRequest(`/presell/actives?page=${next}&limit=${limit}`, 'GET', null, false).then((data) => { const result = data as PresellPage; page.value = result.page || next; total.value = result.total || 0; items.value = reset ? (result.list || []) : items.value.concat(result.list || []) }).catch((error) => uni.showToast({ title: error.message || '预售活动加载失败', icon: 'none' })).finally(() => { loading.value = false }) }
function detail(id: number): void { uni.navigateTo({ url: `/pages/presell/detail?id=${id}` }) }
function finals(): void { uni.navigateTo({ url: '/pages/presell/finals' }) }
onShow(() => load(true))
onReachBottom(() => load())
</script>
<template><view class="qx-page"><qx-nav title="预售专区" /><view class="tip"><text>全款预售一次支付；定金预售需在尾款窗口内完成尾款。</text><text class="finals" @click="finals">待付尾款 ›</text></view><view v-if="items.length == 0 && !loading" class="qx-card empty">暂无预售活动</view><view v-for="item in items" :key="item.product_presell_id" class="qx-card item" @click="detail(item.product_presell_id)"><text class="name">{{ item.store_name }}</text><text class="sub">{{ item.mer_name }} · {{ item.presell_type == 2 ? '定金预售' : '全款预售' }} · 库存 {{ item.stock }}</text><text class="price">¥{{ item.price }}</text><text v-if="item.presell_type == 2" class="sub">定金 ¥{{ item.down_price }}，尾款 ¥{{ item.final_price }}</text></view><view v-if="items.length > 0" class="more">{{ loading ? '正在加载…' : (hasMore() ? '上拉加载更多' : '已经到底了') }}</view></view></template>
<style>.tip { padding: 12px; color: #86909c; font-size: 13px; display: flex; justify-content: space-between; }.finals { color: #d72828; }.empty { color: #86909c; text-align: center; }.name, .sub, .price { display: block; }.name { font-size: 16px; font-weight: 600; }.sub { margin-top: 7px; color: #86909c; font-size: 12px; }.price { margin-top: 10px; color: #d72828; font-size: 19px; font-weight: 700; }.more { padding: 16px 0 28px; color: #86909c; text-align: center; font-size: 13px; }</style>
