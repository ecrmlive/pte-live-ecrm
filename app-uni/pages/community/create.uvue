<script setup lang="uts">
import { appRequest } from '../../common/request'
type Topic={topic_id:number;topic_name:string;category_id:number};type Category={category_id:number;cate_name:string};type TopicData={list:Topic[]};type CategoryData={list:Category[]};const title=ref('');const content=ref('');const topicID=ref(0);const categoryID=ref(0);const topics=ref<Topic[]>([]);const categories=ref<Category[]>([])
function filteredTopics():Topic[]{return topics.value.filter((item)=>categoryID.value==0||item.category_id==categoryID.value)}
function load():void{appRequest('/community/categories','GET',null,false).then((data)=>{categories.value=(data as CategoryData).list||[];if(categories.value.length>0)categoryID.value=categories.value[0].category_id});appRequest('/community/topics','GET',null,false).then((data)=>{topics.value=(data as TopicData).list||[];if(topics.value.length>0)topicID.value=topics.value[0].topic_id})}
function selectCategory(id:number):void{categoryID.value=id;if(topicID.value>0&&!filteredTopics().some((item)=>item.topic_id==topicID.value))topicID.value=0}
function submit():void{if(title.value.trim().length==0||content.value.trim().length==0){uni.showToast({title:'请填写标题和内容',icon:'none'});return};appRequest('/community/posts','POST',{title:title.value.trim(),content:content.value.trim(),topic_id:topicID.value,category_id:categoryID.value} as UTSJSONObject).then(()=>{uni.showToast({title:'已提交审核',icon:'success'});uni.redirectTo({url:'/pages/community/mine'})}).catch((error)=>uni.showToast({title:error.message||'提交失败',icon:'none'}))}
onLoad(()=>load())
</script>
<template><view class="qx-page"><qx-nav title="发布社区内容"/><view class="qx-card"><text class="hint">发布后需平台审核通过才会公开，你可以在“我的发布”查看审核结果。</text><input v-model="title" class="input" maxlength="100" placeholder="标题"/><textarea v-model="content" class="textarea" maxlength="5000" placeholder="分享真实体验或商品攻略"/><text class="hint">内容分类</text><view v-for="cate in categories" :key="cate.category_id" :class="categoryID==cate.category_id?'topic active':'topic'" @click="selectCategory(cate.category_id)">{{cate.cate_name}}</view><text class="hint section">关联话题（可选）</text><view v-for="topic in filteredTopics()" :key="topic.topic_id" :class="topicID==topic.topic_id?'topic active':'topic'" @click="topicID=topic.topic_id">{{topic.topic_name}}</view><button class="qx-primary" @click="submit">提交平台审核</button></view></view></template>
<style>.hint{display:block;color:#86909c;font-size:13px}.section{margin-top:16px}.input,.textarea{width:100%;margin-top:12px;padding:10px;background:#f6f7f9;border-radius:8px;box-sizing:border-box}.textarea{height:150px}.topic{display:inline-block;margin:10px 8px 0 0;padding:7px 12px;background:#f6f7f9;border-radius:16px;font-size:13px}.active{color:#fff;background:#d72828}.qx-primary{margin-top:20px;border-radius:20px}</style>
