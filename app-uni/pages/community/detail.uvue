<script setup lang="uts">
import { appRequest } from '../../common/request'
type Post={title:string;content:string;nickname:string;topic_name:string;count_reply:number};type Reply={reply_id:number;nickname:string;content:string};type ReplyData={list:Reply[]}
const id=ref(0);const post=ref<Post|null>(null);const replies=ref<Reply[]>([]);const draft=ref('')
function load():void{appRequest(`/community/posts/${id.value}`,'GET',null,false).then((data)=>{post.value=data as Post});appRequest(`/community/posts/${id.value}/replies?page=1&limit=50`,'GET',null,false).then((data)=>{replies.value=(data as ReplyData).list||[]})}
function send():void{const content=draft.value.trim();if(content.length==0)return;appRequest(`/community/posts/${id.value}/replies`,'POST',{content:content} as UTSJSONObject).then(()=>{draft.value='';load()}).catch((error)=>uni.showToast({title:error.message||'评论失败',icon:'none'}))} onLoad((query)=>{id.value=Number(query['id']||0);if(id.value>0)load()})
</script>
<template><view class="qx-page"><qx-nav title="社区详情"/><view v-if="post!=null" class="qx-card"><text class="title">{{post.title}}</text><text class="sub">{{post.nickname}} · {{post.topic_name}}</text><text class="body">{{post.content}}</text></view><view class="qx-card"><text class="title">评论</text><view v-for="reply in replies" :key="reply.reply_id" class="reply"><text>{{reply.nickname||'用户'}}</text><text class="body">{{reply.content}}</text></view><input v-model="draft" class="input" placeholder="说点什么…"/><button class="qx-primary" @click="send">发送评论</button></view></view></template>
<style>.title,.sub,.body{display:block}.title{font-size:17px;font-weight:600}.sub{margin-top:8px;color:#86909c;font-size:12px}.body{margin-top:12px;color:#4e5969;line-height:22px}.reply{padding:12px 0;border-top:1px solid #f0f0f0}.input{height:42px;margin-top:12px;padding:0 10px;background:#f6f7f9;border-radius:8px}.qx-primary{margin-top:10px;border-radius:20px}</style>
