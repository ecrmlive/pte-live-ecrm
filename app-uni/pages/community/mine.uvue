<script setup lang="uts">
import { appRequest } from '../../common/request'
type Post={community_id:number;title:string;content:string;topic_name:string;status:number;refusal:string;create_time:string;count_reply:number};type PostData={list:Post[];total:number}
const posts=ref<Post[]>([]);const loading=ref(false)
function statusText(status:number):string{return status==1?'审核通过':status==-1?'已驳回':'待平台审核'}
function load():void{loading.value=true;appRequest('/community/my-posts?page=1&limit=50','GET').then((data)=>{posts.value=(data as PostData).list||[]}).catch((error)=>{uni.showToast({title:error.message||'加载失败',icon:'none'})}).finally(()=>{loading.value=false})}
function create():void{uni.navigateTo({url:'/pages/community/create'})}
onShow(()=>load())
</script>
<template><view class="qx-page"><qx-nav title="我的发布"/><view class="tips">这里会保留你的待审核、已通过和已驳回内容。<text class="publish" @click="create">继续发布</text></view><view v-if="loading" class="qx-card empty">正在加载…</view><view v-else-if="posts.length==0" class="qx-card empty"><text>还没有发布内容</text><button class="qx-primary" @click="create">去发布</button></view><view v-for="post in posts" :key="post.community_id" class="qx-card"><view class="head"><text class="title">{{post.title}}</text><text :class="post.status==1?'status success':post.status==-1?'status danger':'status'">{{statusText(post.status)}}</text></view><text class="sub">{{post.topic_name||'未选择话题'}} · {{post.create_time}}</text><text class="body">{{post.content}}</text><text v-if="post.status==-1&&post.refusal" class="reason">驳回原因：{{post.refusal}}</text><text class="sub">评论 {{post.count_reply||0}}</text></view></view></template>
<style>.tips{padding:12px;color:#86909c;font-size:13px}.publish{float:right;color:#d72828}.empty{color:#86909c;text-align:center}.empty .qx-primary{margin-top:14px;border-radius:22px}.head{display:flex;gap:10px;align-items:flex-start;justify-content:space-between}.title,.sub,.body,.reason{display:block}.title{flex:1;font-size:16px;font-weight:600}.status{padding:3px 8px;color:#e6a23c;background:#fdf6ec;border-radius:12px;font-size:11px}.success{color:#34a853;background:#f0f9eb}.danger{color:#f56c6c;background:#fef0f0}.sub{margin-top:8px;color:#86909c;font-size:12px}.body{display:-webkit-box;overflow:hidden;margin-top:10px;color:#4e5969;font-size:14px;line-height:21px;-webkit-box-orient:vertical;-webkit-line-clamp:3}.reason{margin-top:10px;padding:8px;color:#f56c6c;background:#fef0f0;border-radius:6px;font-size:13px}</style>
