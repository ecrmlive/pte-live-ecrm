<script setup lang="uts">
import { appRequest } from '../../common/request'
type Article = { article_id: number; title: string; create_time: string }
type ArticlePage = { list: Article[]; total: number; page: number; limit: number }
const items = ref<Article[]>([])
const loading = ref(false)
const page = ref(1)
const total = ref(0)
const limit = 20
function hasMore(): boolean { return items.value.length < total.value }
function load(reset: boolean = false): void { if (loading.value || (!reset && !hasMore())) return; const next = reset ? 1 : page.value + 1; loading.value = true; appRequest("/content/articles?page=" + next + "&limit=" + limit, "GET", null, false).then((data) => { const result = data as ArticlePage; page.value = result.page || next; total.value = result.total || 0; items.value = reset ? (result.list || []) : items.value.concat(result.list || []) }).catch((error) => uni.showToast({ title: error.message || '资讯加载失败', icon: 'none' })).finally(() => { loading.value = false }) }
function detail(id: number): void { uni.navigateTo({ url: `/pages/article/detail?id=${id}` }) }
onShow(() => load(true))
onReachBottom(() => load())
</script>
<template><view class="qx-page"><qx-nav title="商城资讯" /><view v-if="items.length == 0 && !loading" class="qx-card empty">暂无商城资讯</view><view v-for="item in items" :key="item.article_id" class="qx-card row" @click="detail(item.article_id)"><text class="title">{{ item.title }}</text><text class="time">{{ item.create_time }}</text><text class="arrow">›</text></view><view v-if="items.length > 0" class="more">{{ loading ? '正在加载更多' : (hasMore() ? '上拉加载更多' : '已经到底了') }}</view></view></template>
<style>.empty { color: #86909c; text-align: center; }.row { position: relative; padding-right: 34px; }.title, .time { display: block; }.title { font-size: 16px; font-weight: 600; }.time { margin-top: 8px; color: #86909c; font-size: 12px; }.arrow { position: absolute; top: 26px; right: 16px; color: #86909c; font-size: 22px; }.more { padding: 16px 0 28px; color: #86909c; text-align: center; font-size: 13px; }</style>
