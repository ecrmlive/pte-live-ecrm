<script setup lang="uts">
import { appRequest } from '../../common/request'
import { CitySelection, setCityPickerResult, setHomeCitySelection } from '../../common/city'

type City = { city_id: number; parent_id: number; name: string; level: number }
type CityResponse = { list: City[] }

const mode = ref('home')
const loading = ref(false)
const trail = ref<City[]>([])
const options = ref<City[]>([])
const failed = ref(false)

function title(): string { return mode.value == 'address' ? '选择收货地区' : '选择当前城市' }
function selectedText(): string {
  const names = trail.value.map((item) => item.name)
  return names.length > 0 ? names.join(' / ') : '请选择配送地区'
}
function requestChildren(parentID: number): void {
  loading.value = true
  failed.value = false
  appRequest('/system/city/lst/' + String(parentID), 'GET', null, false).then((data) => {
    options.value = (data as CityResponse).list || []
  }).catch((error) => {
    options.value = []
    failed.value = true
    uni.showToast({ title: error.message || '城市数据加载失败', icon: 'none' })
  }).finally(() => { loading.value = false })
}
function isTerminal(item: City): boolean { return mode.value == 'home' ? item.level >= 3 : item.level >= 4 }
function selection(item: City): CitySelection {
  const nodes = trail.value.concat([item])
  let province = ''
  let city = ''
  let district = ''
  for (const node of nodes) {
    if (node.level == 2) province = node.name
    else if (node.level == 3) city = node.name
    else if (node.level >= 4) district = node.name
  }
  return { province, city, district, regionCode: String(item.city_id) }
}
function choose(item: City): void {
  if (isTerminal(item)) {
    const result = selection(item)
    if (mode.value == 'address') setCityPickerResult(result)
    else setHomeCitySelection(result)
    uni.showToast({ title: '已切换至' + (result.city || result.province || item.name), icon: 'success' })
    setTimeout(() => uni.navigateBack(), 250)
    return
  }
  trail.value = trail.value.concat([item])
  requestChildren(item.city_id)
}
function goBackLevel(): void {
  if (trail.value.length == 0) { uni.navigateBack(); return }
  trail.value = trail.value.slice(0, trail.value.length - 1)
  const parentID = trail.value.length == 0 ? 0 : trail.value[trail.value.length - 1].city_id
  requestChildren(parentID)
}

onLoad((query) => { mode.value = String(query?.['mode'] || 'home'); requestChildren(0) })
</script>

<template>
  <view class="city-page"><qx-nav :title="title()" />
    <view class="hint"><text>当前选择：{{ selectedText() }}</text><text v-if="trail.length > 0" class="back" @click="goBackLevel">返回上一级</text></view>
    <view v-if="loading" class="state">正在加载城市数据…</view>
    <view v-else-if="failed" class="state"><text>城市数据暂不可用</text><button class="retry" @click="requestChildren(trail.length == 0 ? 0 : trail[trail.length - 1].city_id)">重新加载</button></view>
    <view v-else-if="options.length == 0" class="state">暂无可选地区</view>
    <view v-else class="qx-card city-list"><view v-for="item in options" :key="item.city_id" class="city-item" @click="choose(item)"><text>{{ item.name }}</text><text class="arrow">{{ isTerminal(item) ? '选择' : '›' }}</text></view></view>
  </view>
</template>

<style>
.city-page{min-height:100vh;background:#f6f7f9}.hint{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;color:#4e5969;background:#fff;font-size:13px}.back{flex-shrink:0;color:#d72828}.city-list{margin-top:10px;padding:0 14px}.city-item{height:52px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #f2f3f5;color:#1f2329;font-size:15px}.city-item:last-child{border-bottom:0}.arrow{color:#86909c;font-size:13px}.state{min-height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:#86909c;font-size:14px}.retry{height:34px;margin:0;padding:0 16px;color:#d72828;border:1px solid #d72828;border-radius:17px;background:#fff;font-size:13px;line-height:32px}
</style>
