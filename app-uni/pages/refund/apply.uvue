<script setup lang="uts">
import { appRequest } from '../../common/request'

const orderID = ref(0)
const message = ref('')
const refundType = ref(1)
const submitting = ref(false)

function submit(): void {
  const reason = message.value.trim()
  if (orderID.value == 0 || reason.length == 0) { uni.showToast({ title: '请填写退款原因', icon: 'none' }); return }
  if (submitting.value) return
  uni.showModal({ title: '提交售后申请', content: '提交后将等待商家审核，确认继续吗？', success: (result) => {
    if (!result.confirm || submitting.value) return
    submitting.value = true
    appRequest('/refund/apply', 'POST', { order_id: orderID.value, refund_type: refundType.value, refund_message: reason } as UTSJSONObject).then((data) => {
      const item = data as UTSJSONObject
      uni.showToast({ title: '申请已提交', icon: 'success' })
      uni.redirectTo({ url: '/pages/refund/detail?id=' + String(item['refund_order_id'] as number) })
    }).catch((error) => uni.showToast({ title: error.message || '申请失败', icon: 'none' })).finally(() => { submitting.value = false })
  } })
}
onLoad((query) => { orderID.value = Number(query?.['order_id'] || 0) })
</script>

<template><view class="qx-page"><qx-nav title="申请售后" /><view class="qx-card"><text class="label">订单 ID：{{ orderID }}</text><view class="type-row"><button :class="refundType == 1 ? 'type active' : 'type'" @click="refundType = 1">仅退款</button><button :class="refundType == 2 ? 'type active' : 'type'" @click="refundType = 2">退货退款</button></view><text class="hint">{{ refundType == 1 ? '商家同意后进入退款处理，到账以支付渠道回调为准。' : '商家同意后请按指引寄回商品并登记物流。' }}</text><textarea v-model="message" class="textarea" maxlength="500" placeholder="请填写售后原因（必填）" /></view><view class="footer"><button :loading="submitting" class="qx-primary" @click="submit">提交申请</button></view></view></template>

<style>.label { display: block; margin-bottom: 14px; color: #4e5969; font-size: 14px; }.type-row { display: flex; gap: 10px; margin-bottom: 10px; }.type { flex: 1; color: #4e5969; background-color: #f6f7f9; border: 1px solid #f6f7f9; border-radius: 8px; font-size: 14px; }.type.active { color: #d72828; background-color: #fff1f0; border-color: #d72828; }.hint { display: block; margin-bottom: 14px; color: #86909c; font-size: 12px; line-height: 18px; }.textarea { width: 100%; height: 140px; padding: 12px; background-color: #f6f7f9; border-radius: 8px; box-sizing: border-box; }.footer { padding: 12px; background-color: #ffffff; }.qx-primary { border-radius: 22px; font-size: 15px; }</style>
