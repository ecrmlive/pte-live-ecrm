<script setup lang="uts">
import { appRequest } from '../../common/request'

const id = ref(0)
const carrierName = ref('CRM Live 演示快递')
const trackingNo = ref('')
const remark = ref('')
const submitting = ref(false)

function submit(): void {
  if (id.value == 0 || carrierName.value.trim().length == 0 || trackingNo.value.trim().length < 3) { uni.showToast({ title: '请填写承运商和有效运单号', icon: 'none' }); return }
  submitting.value = true
  appRequest(`/refunds/${id.value}/return-shipment`, 'POST', { carrier_name: carrierName.value.trim(), tracking_no: trackingNo.value.trim(), remark: remark.value.trim() } as UTSJSONObject).then(() => { uni.showToast({ title: '物流已登记', icon: 'success' }); setTimeout(() => uni.navigateBack(), 500) }).catch((error) => uni.showToast({ title: error.message || '登记失败', icon: 'none' })).finally(() => { submitting.value = false })
}
onLoad((query) => { id.value = Number(query?.['id'] || 0) })
</script>

<template><view class="qx-page"><qx-nav title="登记退货物流" /><view class="qx-card"><text class="hint">请在寄出商品后如实登记物流。提交后将等待商户确认收货。</text><input v-model="carrierName" class="input" maxlength="128" placeholder="承运商名称" /><input v-model="trackingNo" class="input" maxlength="128" placeholder="运单号" /><textarea v-model="remark" class="textarea" maxlength="500" placeholder="备注（可选）" /></view><view class="footer"><button :loading="submitting" class="qx-primary" @click="submit">确认登记</button></view></view></template>

<style>.hint { display: block; margin-bottom: 14px; color: #86909c; font-size: 13px; line-height: 20px; }.input { width: 100%; height: 44px; margin-bottom: 12px; padding: 0 12px; background-color: #f6f7f9; border-radius: 8px; box-sizing: border-box; }.textarea { width: 100%; height: 120px; padding: 12px; background-color: #f6f7f9; border-radius: 8px; box-sizing: border-box; }.footer { padding: 12px; background-color: #ffffff; }.qx-primary { border-radius: 22px; font-size: 15px; }</style>
