<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
import { getCheckoutAddressID } from '../../common/checkout-address'
type Helper = { uid: number; nickname: string }
type AssistSet = { product_assist_set_id: number; uid: number; status: number; assist_count: number; yet_assist_count: number; assist_price: number; store_name: string; nickname: string; helpers: Helper[] }
type Profile = { uid: number }
type Address = { address_id: number; is_default: number }; type AddressData = { list: Address[] }; type GroupOrder = { group_order_id: number }
const id = ref(0); const item = ref<AssistSet | null>(null); const myUID = ref(0); const busy = ref(false); const createKey = ref("")
function hasAssistSet(): boolean { return item.value != null }
function assistSetName(): string { const set = item.value; return set == null ? '助力单加载中' : set.store_name }
function assistSetProgress(): string { const set = item.value; return set == null ? '--' : statusText(set.status) + ' · ' + set.yet_assist_count.toString() + '/' + set.assist_count.toString() + ' 人' }
function assistSetPrice(): number { const set = item.value; return set == null ? 0 : set.assist_price }
function assistSetOwner(): string { const set = item.value; return set == null ? '--' : set.nickname }
function helpers(): Helper[] { const set = item.value; return set == null ? [] : set.helpers }
function helpersEmpty(): boolean { return helpers().length == 0 }
function canHelp(): boolean { const set = item.value; return set != null && set.status == 1 }
function canOrder(): boolean { const set = item.value; return set != null && set.status == 10 && set.uid == myUID.value }
function load(): void { if (id.value <= 0) return; appRequest(`/assist/sets/${id.value}`, 'GET', null, false).then((data) => { item.value = data as AssistSet }).catch((error) => uni.showToast({ title: error.message || '助力单加载失败', icon: 'none' })); if (getAccessToken().length > 0) appRequest('/auth/me').then((data) => { myUID.value = (data as Profile).uid }).catch(() => { myUID.value = 0 }) }
function statusText(status: number): string { if (status == 1) return '助力中'; if (status == 10) return '已满员可下单'; if (status == 11) return '待支付'; if (status == 20) return '已支付'; return '已结束' }
function help(): void { if (getAccessToken().length == 0) { uni.navigateTo({ url: '/pages/login/index' }); return }; busy.value = true; appRequest(`/assist/sets/${id.value}/help`, 'POST', {} as UTSJSONObject).then((data) => { item.value = data as AssistSet; uni.showToast({ title: '助力成功', icon: 'success' }) }).catch((error) => uni.showToast({ title: error.message || '助力失败', icon: 'none' })).finally(() => { busy.value = false }) }
function order(): void { if (item.value == null) return; if (createKey.value.length == 0) createKey.value = "assist-order-" + Date.now().toString() + "-" + Math.random().toString(36).slice(2); busy.value = true; let addressID = 0; appRequest('/address').then((data) => { const list = (data as AddressData).list || []; const address = list.find((row) => row.address_id == getCheckoutAddressID()) || list.find((row) => row.is_default == 1) || (list.length > 0 ? list[0] : null); if (address == null) { uni.navigateTo({ url: '/pages/address/list?select=1' }); throw new Error('请先添加收货地址') }; addressID = address.address_id; return appRequest('/order/assist/check', 'POST', { product_assist_set_id: id.value, cart_num: 1, address_id: addressID } as UTSJSONObject) }).then(() => appRequest('/order/assist/create', 'POST', { product_assist_set_id: id.value, cart_num: 1, address_id: addressID, idempotency_key: createKey.value } as UTSJSONObject)).then((data) => { uni.navigateTo({ url: `/pages/order/detail?id=${(data as GroupOrder).group_order_id}` }) }).catch((error) => uni.showToast({ title: error.message || '助力下单失败', icon: 'none' })).finally(() => { busy.value = false }) }
onLoad((query) => { id.value = Number(query?.['id'] || 0); load() }); onShow(() => { if (id.value > 0) load() })
</script>
<template><view class="qx-page"><qx-nav title="助力单" /><view v-if="hasAssistSet()" class="qx-card"><text class="name">{{ assistSetName() }}</text><text class="sub">{{ assistSetProgress() }}</text><text class="price">助力价 ¥{{ assistSetPrice() }}</text><text class="sub">发起人：{{ assistSetOwner() }}</text></view><view v-if="hasAssistSet()" class="qx-card"><text class="name">已助力好友</text><text v-if="helpersEmpty()" class="sub">暂未有人助力</text><text v-for="helper in helpers()" :key="helper.uid" class="helper">{{ helper.nickname || '好友' }}</text></view><view v-if="canHelp()" class="footer"><button :loading="busy" class="qx-primary" @click="help">帮 TA 助力</button></view><view v-if="canOrder()" class="footer"><button :loading="busy" class="qx-primary" @click="order">按助力价下单</button></view></view></template>
<style>.name, .sub, .price, .helper { display: block; }.name { font-size: 17px; font-weight: 600; }.sub { margin-top: 9px; color: #86909c; font-size: 13px; }.price { margin-top: 16px; color: #d72828; font-size: 23px; font-weight: 700; }.helper { margin-top: 12px; padding-top: 12px; border-top: 1px solid #f0f0f0; color: #4e5969; font-size: 14px; }.footer { padding: 12px; background-color: #ffffff; }.qx-primary { border-radius: 22px; font-size: 15px; }</style>
