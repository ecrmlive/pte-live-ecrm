<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
type Helper = { uid: number; nickname: string }
type AssistSet = { product_assist_set_id: number; uid: number; status: number; assist_count: number; yet_assist_count: number; assist_price: number; store_name: string; nickname: string; helpers: Helper[] }
type Profile = { uid: number }
type Address = { address_id: number; is_default: number }; type AddressData = { list: Address[] }; type GroupOrder = { group_order_id: number }
const id = ref(0); const item = ref<AssistSet | null>(null); const myUID = ref(0); const busy = ref(false)
function load(): void { if (id.value <= 0) return; appRequest(`/assist/sets/${id.value}`, 'GET', null, false).then((data) => { item.value = data as AssistSet }).catch((error) => uni.showToast({ title: error.message || '助力单加载失败', icon: 'none' })); if (getAccessToken().length > 0) appRequest('/auth/me').then((data) => { myUID.value = (data as Profile).uid }).catch(() => { myUID.value = 0 }) }
function statusText(status: number): string { if (status == 1) return '助力中'; if (status == 10) return '已满员可下单'; if (status == 20) return '已支付'; return '已结束' }
function help(): void { if (getAccessToken().length == 0) { uni.navigateTo({ url: '/pages/login/index' }); return }; busy.value = true; appRequest(`/assist/sets/${id.value}/help`, 'POST', {} as UTSJSONObject).then((data) => { item.value = data as AssistSet; uni.showToast({ title: '助力成功', icon: 'success' }) }).catch((error) => uni.showToast({ title: error.message || '助力失败', icon: 'none' })).finally(() => { busy.value = false }) }
function order(): void { if (item.value == null) return; busy.value = true; let addressID = 0; appRequest('/address').then((data) => { const list = (data as AddressData).list || []; const address = list.find((row) => row.is_default == 1) || (list.length > 0 ? list[0] : null); if (address == null) { uni.navigateTo({ url: '/pages/address/list' }); throw new Error('请先添加收货地址') }; addressID = address.address_id; return appRequest('/order/assist/check', 'POST', { product_assist_set_id: id.value, cart_num: 1, address_id: addressID } as UTSJSONObject) }).then(() => appRequest('/order/assist/create', 'POST', { product_assist_set_id: id.value, cart_num: 1, address_id: addressID } as UTSJSONObject)).then((data) => { uni.navigateTo({ url: `/pages/order/detail?id=${(data as GroupOrder).group_order_id}` }) }).catch((error) => uni.showToast({ title: error.message || '助力下单失败', icon: 'none' })).finally(() => { busy.value = false }) }
onLoad((query) => { id.value = Number(query['id'] || 0); load() }); onShow(() => { if (id.value > 0) load() })
</script>
<template><view class="qx-page"><qx-nav title="助力单" /><view v-if="item != null" class="qx-card"><text class="name">{{ item.store_name }}</text><text class="sub">{{ statusText(item.status) }} · {{ item.yet_assist_count }}/{{ item.assist_count }} 人</text><text class="price">助力价 ¥{{ item.assist_price }}</text><text class="sub">发起人：{{ item.nickname }}</text></view><view v-if="item != null" class="qx-card"><text class="name">已助力好友</text><text v-if="item.helpers.length == 0" class="sub">暂未有人助力</text><text v-for="helper in item.helpers" :key="helper.uid" class="helper">{{ helper.nickname || '好友' }}</text></view><view v-if="item != null && item.status == 1" class="footer"><button :loading="busy" class="qx-primary" @click="help">帮 TA 助力</button></view><view v-if="item != null && item.status == 10 && item.uid == myUID" class="footer"><button :loading="busy" class="qx-primary" @click="order">按助力价下单</button></view></view></template>
<style>.name, .sub, .price, .helper { display: block; }.name { font-size: 17px; font-weight: 600; }.sub { margin-top: 9px; color: #86909c; font-size: 13px; }.price { margin-top: 16px; color: #d72828; font-size: 23px; font-weight: 700; }.helper { margin-top: 12px; padding-top: 12px; border-top: 1px solid #f0f0f0; color: #4e5969; font-size: 14px; }.footer { padding: 12px; background-color: #ffffff; }.qx-primary { border-radius: 22px; font-size: 15px; }</style>
