<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
type Assist = { product_assist_id: number; store_name: string; mer_name: string; assist_count: number; assist_price: number }
type AssistSet = { product_assist_set_id: number; status: number; yet_assist_count: number; assist_count: number }
type SetData = { list: AssistSet[] }
const id = ref(0); const item = ref<Assist | null>(null); const sets = ref<AssistSet[]>([]); const starting = ref(false)
function load(): void { if (id.value <= 0) return; appRequest(`/assist/actives/${id.value}`, 'GET', null, false).then((data) => { item.value = data as Assist }).catch((error) => uni.showToast({ title: error.message || '助力活动加载失败', icon: 'none' })); appRequest(`/assist/actives/${id.value}/sets`, 'GET', null, false).then((data) => { sets.value = (data as SetData).list || [] }).catch(() => { sets.value = [] }) }
function statusText(status: number): string { if (status == 1) return '助力中'; if (status == 10) return '已满员'; if (status == 20) return '已支付'; return '已结束' }
function goSet(setID: number): void { uni.navigateTo({ url: `/pages/assist/set?id=${setID}` }) }
function start(): void { if (getAccessToken().length == 0) { uni.navigateTo({ url: '/pages/login/index' }); return }; starting.value = true; appRequest(`/assist/actives/${id.value}/start`, 'POST', {} as UTSJSONObject).then((data) => { const set = data as AssistSet; uni.navigateTo({ url: `/pages/assist/set?id=${set.product_assist_set_id}` }) }).catch((error) => uni.showToast({ title: error.message || '发起助力失败', icon: 'none' })).finally(() => { starting.value = false }) }
onLoad((query) => { id.value = Number(query['id'] || 0); load() }); onShow(() => { if (id.value > 0) load() })
</script>
<template><view class="qx-page"><qx-nav title="助力详情" /><view v-if="item != null" class="hero"><text class="name">{{ item.store_name }}</text><text class="sub">{{ item.mer_name }} · 需 {{ item.assist_count }} 人助力</text><text class="price">助力价 ¥{{ item.assist_price }}</text></view><view class="qx-card"><text class="title">进行中的助力</text><view v-if="sets.length == 0" class="empty">暂无进行中的助力</view><view v-for="set in sets" :key="set.product_assist_set_id" class="set" @click="goSet(set.product_assist_set_id)"><text>{{ statusText(set.status) }} · {{ set.yet_assist_count }}/{{ set.assist_count }} 人</text><text>›</text></view></view><view class="footer"><button :loading="starting" class="qx-primary" @click="start">发起助力</button></view></view></template>
<style>.hero { margin: 12px; padding: 20px; color: #ffffff; background: linear-gradient(135deg, #c43757, #e46c84); border-radius: 12px; }.name, .sub, .price { display: block; }.name { font-size: 21px; font-weight: 700; }.sub { margin-top: 9px; font-size: 13px; opacity: 0.9; }.price { margin-top: 15px; font-size: 24px; font-weight: 700; }.title { display: block; font-size: 16px; font-weight: 600; }.empty { padding: 18px 0 4px; color: #86909c; text-align: center; }.set { display: flex; justify-content: space-between; padding: 14px 0; border-top: 1px solid #f0f0f0; color: #4e5969; font-size: 14px; }.footer { padding: 12px; background-color: #ffffff; }.qx-primary { border-radius: 22px; font-size: 15px; }</style>
