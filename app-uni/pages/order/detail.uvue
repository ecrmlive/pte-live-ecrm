<script setup lang="uts">
import { appRequest } from '../../common/request'

type StoreOrder = { order_id: number; mer_id: number; mer_name: string; pay_price: number; paid: number; status: number; delivery_name: string; delivery_id: string; verify_code: string; reservation_date: string; reservation_time_part: string }
type GroupOrder = { group_order_id: number; group_order_sn: string; pay_price: number; paid: number; real_name: string; user_phone: string; user_address: string; orders: StoreOrder[] }
const item = ref<GroupOrder | null>(null)
const id = ref(0)

function load(): void {
  if (id.value == 0) return
  appRequest(`/orders/${id.value}`).then((data) => {
    item.value = data as GroupOrder
  }).catch((error) => uni.showToast({ title: error.message || '加载失败', icon: 'none' }))
}

function statusText(status: number, paid: number): string {
  if (paid == 0) return '待付款'
  if (status == 0) return '待发货'
  if (status == 1) return '待收货'
  if (status == 2) return '待评价'
  if (status == 3) return '已完成'
  if (status == 9) return '拼团中'
  if (status == 10) return '待付尾款'
  if (status == 11) return '尾款超时'
  if (status == -1) return '已退款'
  return `状态 ${status}`
}

function goPay(): void { if (item.value != null && item.value.paid == 0) uni.navigateTo({ url: `/pages/order/pay?id=${id.value}` }) }

function refund(orderID: number): void { uni.navigateTo({ url: `/pages/refund/apply?order_id=${orderID}` }) }

onLoad((query) => { id.value = Number(query['id'] || 0); load() })
</script>

<template>
  <view v-if="item != null" class="qx-page"><qx-nav title="订单详情" /><view class="qx-card"><text class="status">{{ item.paid == 1 ? '已支付' : '待付款' }}</text><text class="text">订单号：{{ item.group_order_sn }}</text><text class="text">应付金额：¥{{ item.pay_price }}</text><text class="text">{{ item.real_name }} {{ item.user_phone }}</text><text class="address">{{ item.user_address }}</text></view><view v-for="order in item.orders" :key="order.order_id" class="qx-card"><text class="merchant">{{ order.mer_name || `商户 ${order.mer_id}` }}</text><text class="text">¥{{ order.pay_price }} · {{ statusText(order.status, order.paid) }}</text><text v-if="order.verify_code && order.paid == 1" class="verify">核销码：{{ order.verify_code }}</text><text v-if="order.reservation_date" class="address">预约：{{ order.reservation_date }} {{ order.reservation_time_part }}</text><text v-if="order.delivery_id" class="address">物流：{{ order.delivery_name }} {{ order.delivery_id }}</text><button v-if="order.paid == 1 && order.status != -1" class="refund" @click="refund(order.order_id)">申请退款</button></view><view v-if="item.paid == 0" class="footer"><button class="qx-primary" @click="goPay">去付款</button></view></view>
</template>

<style>.status { display: block; color: #d72828; font-size: 20px; font-weight: 700; }.text { display: block; margin-top: 10px; font-size: 14px; }.address { display: block; margin-top: 10px; color: #86909c; font-size: 13px; line-height: 20px; }.verify { display: block; margin-top: 12px; color: #d72828; font-size: 18px; font-weight: 700; }.merchant { display: block; margin-bottom: 8px; font-size: 15px; font-weight: 600; }.refund { width: 100px; margin: 14px 0 0; color: #d72828; background-color: #ffffff; border: 1px solid #d72828; border-radius: 18px; font-size: 13px; }.footer { padding: 12px; background-color: #ffffff; }.qx-primary { margin-bottom: 8px; border-radius: 22px; font-size: 15px; }.unavailable { color: #86909c; font-size: 13px; }</style>
