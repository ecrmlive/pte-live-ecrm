<script setup lang="uts">
import { appRequest } from '../../common/request'

type Address = { address_id: number; real_name: string; phone: string; province: string; city: string; district: string; detail: string; is_default: number }
type AddressData = { list: Address[] }
type CheckResult = { pay_price: number; total_num: number; total_postage: number; coupon_price: number; integral_price: number }
type Coupon = { coupon_user_id: number; coupon_title: string; coupon_price: number }
type CouponData = { list: Coupon[] }

const cartIDs = ref<number[]>([])
const address = ref<Address | null>(null)
const check = ref<CheckResult | null>(null)
const coupons = ref<Coupon[]>([])
const selectedCouponID = ref(0)
const submitting = ref(false)

function refreshCheck(): void {
  appRequest('/v2/order/check', 'POST', { cart_ids: cartIDs.value, coupon_user_ids: selectedCouponID.value > 0 ? [selectedCouponID.value] : [], use_integral: 0 } as UTSJSONObject).then((data) => { check.value = data as CheckResult }).catch((error) => uni.showToast({ title: error.message || '订单核对失败', icon: 'none' }))
}
function load(): void {
  appRequest('/address').then((data) => { const list = (data as AddressData).list || []; address.value = list.find((item) => item.is_default == 1) || (list.length > 0 ? list[0] : null) }).catch((error) => uni.showToast({ title: error.message || '地址加载失败', icon: 'none' }))
  appRequest(`/coupons/usable?cart_ids=${cartIDs.value.join(',')}`).then((data) => { coupons.value = (data as CouponData).list || [] }).catch(() => { coupons.value = [] })
  refreshCheck()
}
function goAddress(): void { uni.navigateTo({ url: '/pages/address/list' }) }
function selectCoupon(id: number): void { selectedCouponID.value = selectedCouponID.value == id ? 0 : id; refreshCheck() }
function submit(): void {
  if (address.value == null || cartIDs.value.length == 0) { uni.showToast({ title: '请先选择收货地址和商品', icon: 'none' }); return }
  submitting.value = true
  appRequest('/v2/order/create', 'POST', { cart_ids: cartIDs.value, address_id: address.value.address_id, coupon_user_ids: selectedCouponID.value > 0 ? [selectedCouponID.value] : [], use_integral: 0 } as UTSJSONObject).then((data) => { const order = data as UTSJSONObject; uni.redirectTo({ url: `/pages/order/pay?id=${order['group_order_id'] as number}` }) }).catch((error) => uni.showToast({ title: error.message || '下单失败', icon: 'none' })).finally(() => { submitting.value = false })
}
onLoad((query) => { cartIDs.value = String(query['cart_ids'] || '').split(',').map((item) => Number(item)).filter((item) => item > 0); load() })
onShow(() => { if (cartIDs.value.length > 0) load() })
</script>

<template><view class="qx-page"><qx-nav title="确认订单" /><view class="qx-card" @click="goAddress"><text v-if="address != null" class="address">{{ address.real_name }} {{ address.phone }}<text class="next">›</text></text><text v-if="address != null" class="detail">{{ address.province }}{{ address.city }}{{ address.district }}{{ address.detail }}</text><text v-else class="empty">请新增收货地址 ›</text></view><view v-if="coupons.length > 0" class="qx-card"><text class="title">优惠券</text><view v-for="coupon in coupons" :key="coupon.coupon_user_id" class="coupon" @click="selectCoupon(coupon.coupon_user_id)"><text>{{ selectedCouponID == coupon.coupon_user_id ? '●' : '○' }} {{ coupon.coupon_title }}</text><text>¥{{ coupon.coupon_price }}</text></view></view><view class="qx-card"><text class="title">订单金额</text><view v-if="check != null"><text class="line">商品数量：{{ check.total_num }}</text><text class="line">运费：¥{{ check.total_postage }}</text><text class="line">优惠：-¥{{ check.coupon_price + check.integral_price }}</text><text class="total">应付：¥{{ check.pay_price }}</text></view></view><view class="footer"><button :loading="submitting" class="qx-primary" @click="submit">提交订单</button></view></view></template>

<style>.address { display: block; font-size: 16px; font-weight: 600; }.next { float: right; color: #86909c; }.detail, .line { display: block; margin-top: 10px; color: #4e5969; font-size: 14px; }.empty { color: #d72828; }.title { display: block; font-weight: 600; }.coupon { margin-top: 12px; display: flex; justify-content: space-between; color: #4e5969; font-size: 14px; }.total { display: block; margin-top: 16px; color: #d72828; font-size: 20px; font-weight: 700; }.footer { padding: 12px; background-color: #ffffff; }.qx-primary { border-radius: 22px; font-size: 15px; }</style>
