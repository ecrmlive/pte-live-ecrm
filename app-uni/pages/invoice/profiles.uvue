<script setup lang="uts">
import { appRequest } from '../../common/request'
type Profile = { id:number; type:string; title:string; tax_no:string; email:string; is_default:boolean }
type ProfilePage = { list: Profile[] }
const types=['个人','企业']; const type=ref('personal'); const title=ref(''); const taxNo=ref(''); const email=ref(''); const isDefault=ref(false); const editingID=ref(0); const items=ref<Profile[]>([]); const saving=ref(false)
function load():void{appRequest('/invoice-profiles').then((data)=>{items.value=(data as ProfilePage).list||[]}).catch((error)=>uni.showToast({title:error.message||'抬头加载失败',icon:'none'}))}
function reset():void{editingID.value=0;type.value='personal';title.value='';taxNo.value='';email.value='';isDefault.value=false}
function edit(item:Profile):void{editingID.value=item.id;type.value=item.type;title.value=item.title;taxNo.value=item.tax_no;email.value=item.email;isDefault.value=item.is_default}
function save():void{if(title.value.trim().length==0){uni.showToast({title:'请填写发票抬头',icon:'none'});return};if(type.value=='enterprise'&&taxNo.value.trim().length==0){uni.showToast({title:'企业抬头需要税号',icon:'none'});return};saving.value=true;const data={type:type.value,title:title.value.trim(),tax_no:taxNo.value.trim(),email:email.value.trim(),is_default:isDefault.value} as UTSJSONObject;const path=editingID.value>0?'/invoice-profiles/'+editingID.value:'/invoice-profiles';appRequest(path,editingID.value>0?'PUT':'POST',data).then(()=>{uni.showToast({title:'已保存',icon:'success'});reset();load()}).catch((error)=>uni.showToast({title:error.message||'保存失败',icon:'none'})).finally(()=>{saving.value=false})}
function setDefault(id:number):void{appRequest('/invoice-profiles/'+id+'/default','POST',{} as UTSJSONObject).then(()=>load()).catch((error)=>uni.showToast({title:error.message||'设置失败',icon:'none'}))}
function remove(id:number):void{uni.showModal({title:'删除抬头',content:'已申请发票会保留提交时的抬头快照，确认删除此抬头吗？',success:(result)=>{if(!result.confirm)return;appRequest('/invoice-profiles/'+id,'DELETE').then(()=>{if(editingID.value==id)reset();load()}).catch((error)=>uni.showToast({title:error.message||'删除失败',icon:'none'}))}})}
onShow(()=>load())
</script>
<template><view class="qx-page"><qx-nav title="开票抬头"/><view class="qx-card"><picker :range="types" @change="(event)=>type=Number(event.detail.value)==1?'enterprise':'personal'"><view class="field">抬头类型：{{type=='enterprise'?'企业':'个人'}} ›</view></picker><input v-model="title" class="input" placeholder="发票抬头"/><input v-if="type=='enterprise'" v-model="taxNo" class="input" placeholder="纳税人识别号"/><input v-model="email" class="input" placeholder="电子邮箱（可选）"/><view class="default" @click="isDefault=!isDefault"><text>{{isDefault?'☑':'□'}} 设为默认抬头</text><text v-if="editingID>0" class="reset" @click.stop="reset">取消编辑</text></view><button :loading="saving" class="qx-primary" @click="save">{{editingID>0?'保存修改':'新增抬头'}}</button></view><view v-if="items.length==0" class="qx-card empty">还没有开票抬头</view><view v-for="item in items" :key="item.id" class="qx-card profile"><text class="title">{{item.title}}</text><text class="meta">{{item.type=='enterprise'?'企业抬头':'个人抬头'}}{{item.is_default?' · 默认':''}}</text><text v-if="item.tax_no" class="meta">税号：{{item.tax_no}}</text><text v-if="item.email" class="meta">邮箱：{{item.email}}</text><view class="actions"><button v-if="!item.is_default" class="plain" @click="setDefault(item.id)">设为默认</button><button class="plain" @click="edit(item)">编辑</button><button class="danger" @click="remove(item.id)">删除</button></view></view></view></template>
<style>.field{height:44px;line-height:44px;color:#4e5969}.input{width:100%;height:44px;margin-top:10px;padding:0 12px;box-sizing:border-box;background:#f6f7f9;border-radius:8px}.default{height:44px;display:flex;align-items:center;justify-content:space-between;color:#4e5969}.reset{color:#d72828}.qx-primary{border-radius:22px}.empty{color:#86909c;text-align:center}.profile text{display:block}.title{font-size:16px;font-weight:600}.meta{margin-top:7px;color:#86909c;font-size:13px}.actions{margin-top:10px;display:flex;gap:12px}.plain,.danger{margin:0;padding:0;background:transparent;font-size:13px}.plain{color:#d72828}.danger{color:#f53f3f}</style>
