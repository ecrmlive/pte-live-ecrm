# pte-live-ecrm 平台后台 Vben — 开发环境

# 11524 已由 pte-live 的历史平台容器占用；七禧本机 Vben 使用独立端口。
VITE_PORT=15124
VITE_BASE=/

VITE_APP_TITLE=七禧多商户·平台
VITE_APP_NAMESPACE=pte-live-ecrm-platform-admin
VITE_PTE_BRAND=qixi

# 本机开发统一由 Vite 同源反代，避免浏览器直接访问 Docker 端口时出现跨域或
# 宿主机网络命名空间差异；代理目标见 vite.config.ts。
VITE_GLOB_API_URL=/
VITE_API_BASE_URL=/

# 店铺管理系统（admin-merchant）入口；平台「店铺列表 → 登录」新开此源。
# 本地端口与 admin-merchant/vite.config.ts、.env.test 一致：11525
VITE_MERCHANT_ADMIN_URL=http://127.0.0.1:11525

# 地图 Key 走后台云服务配置（amap），见 sql/admin/init_key.sql；勿再用前端 env。

VITE_NITRO_MOCK=false
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true
VITE_ROUTER_HISTORY=hash
