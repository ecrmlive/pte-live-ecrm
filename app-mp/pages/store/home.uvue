<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
import { activateMerchantContext } from '../../common/store-context'
type Product={id:number;store_name:string;price:string};type Store={mer_id:number;mer_name:string;merchant_app_id:string;products:Product[]};const item=ref<Store|null>(null)
function goods(id:number):void{uni.navigateTo({url:`/pages/goods/detail?id=${id}`})}function contact():void{if(item.value==null)return;if(getAccessToken().length==0){uni.navigateTo({url:'/pages/login/index'});return};uni.navigateTo({url:`/pages/cs/chat?mer_id=${item.value.mer_id}`})}onLoad((query)=>{const id=Number(query['mer_id']||0);if(id>0)appRequest(`/catalog/stores/${id}`,'GET',null,false).then((data)=>{item.value=data as Store;const store=data as Store;if(getAccessToken().length>0&&store.merchant_app_id.length>0){activateMerchantContext(store.merchant_app_id).catch(()=>uni.showToast({title:'店铺已加载，请重新登录后再购买',icon:'none'}))}}).catch((error)=>uni.showToast({title:error.message||'店铺加载失败',icon:'none'}))})
</script>
<template><view class="qx-page"><qx-nav title="店铺主页"/><view v-if="item!=null" class="hero"><text>{{item.mer_name||`店铺 ${item.mer_id}`}}</text><text>本店在售商品</text><button @click="contact">联系客服</button></view><view v-if="item!=null&&item.products.length==0" class="qx-card empty">暂无上架商品</view><view v-if="item!=null" v-for="product in item.products" :key="product.id" class="qx-card row" @click="goods(product.id)"><text>{{product.store_name}}</text><text class="price">¥{{product.price}} ›</text></view></view></template>
<style>.hero{margin:12px;padding:20px;color:#fff;background:#d72828;border-radius:12px}.hero text{display:block}.hero text:first-child{font-size:21px;font-weight:700}.hero text:nth-child(2){margin-top:8px;font-size:13px}.hero button{width:120px;height:36px;margin:16px 0 0;padding:0;border:1px solid #fff;border-radius:18px;color:#fff;background:transparent;font-size:13px;line-height:34px}.row{display:flex;justify-content:space-between;font-size:15px}.price{color:#d72828;font-weight:600}.empty{color:#86909c;text-align:center}</style>
