<script setup lang="uts">
import { appRequest } from '../../common/request'
type Active={seckill_active_id:number;product_id:number;store_name:string;mer_name:string;seckill_price:number;price:number;in_window:boolean;start_day:string;end_day:string};type ActivePage={list:Active[]};const items=ref<Active[]>([])
function load():void{appRequest('/seckill/actives?page=1&limit=30','GET',null,false).then((data)=>{items.value=(data as ActivePage).list||[]}).catch((error)=>uni.showToast({title:error.message||'秒杀活动加载失败',icon:'none'}))}function goods(id:number):void{uni.navigateTo({url:`/pages/goods/detail?id=${id}`})}onShow(()=>load())
</script>
<template><view class="qx-page"><qx-nav title="秒杀专区"/><view class="tip">活动价格与库存以服务端实时状态为准。</view><view v-if="items.length==0" class="qx-card empty">暂无秒杀活动</view><view v-for="item in items" :key="item.seckill_active_id" class="qx-card" @click="goods(item.product_id)"><text class="title">{{item.store_name}}</text><text class="sub">{{item.mer_name}} · {{item.in_window?'抢购中':'未开场'}} · {{item.start_day}} 至 {{item.end_day}}</text><text class="price">秒杀价 ¥{{item.seckill_price}}</text><text class="original">¥{{item.price}}</text></view></view></template>
<style>.tip{padding:12px;color:#86909c;font-size:13px}.empty{color:#86909c;text-align:center}.title,.sub,.price,.original{display:block}.title{font-size:16px;font-weight:600}.sub{margin-top:8px;color:#86909c;font-size:12px}.price{margin-top:11px;color:#d72828;font-size:19px;font-weight:700}.original{margin-top:4px;color:#86909c;font-size:12px;text-decoration:line-through}</style>
