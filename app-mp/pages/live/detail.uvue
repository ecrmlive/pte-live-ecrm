<script setup lang="uts">
import { appRequest } from '../../common/request'
type Goods={product_id:number;store_name:string;price:number;on_sale:number};type Room={broadcast_room_id:number;name:string;mer_name:string;anchor_name:string;cover_img:string;live_status:number;play_url:string;goods:Goods[]};const item=ref<Room|null>(null)
function label(status:number):string{if(status==101)return '直播中';if(status==103)return '已结束';return '未开始'} function goods(id:number):void{uni.navigateTo({url:`/pages/goods/detail?id=${id}`})}
onLoad((query)=>{const id=Number(query['id']||0);if(id>0)appRequest(`/live/rooms/${id}`,'GET',null,false).then((data)=>{item.value=data as Room}).catch((error)=>uni.showToast({title:error.message||'直播间加载失败',icon:'none'}))})
</script>
<template><view class="qx-page"><qx-nav title="直播详情"/><view v-if="item!=null" class="hero"><text class="name">{{item.name}}</text><text class="sub">{{item.mer_name}} · 主播 {{item.anchor_name||'-'}} · {{label(item.live_status)}}</text></view><view v-if="item!=null" class="player"><video v-if="item.live_status==101&&item.play_url" :poster="item.cover_img" :src="item.play_url" controls autoplay></video><text v-else>{{item.live_status==101?'直播播放地址暂未配置':'直播尚未开始或已结束'}}</text></view><view v-if="item!=null" class="qx-card"><text class="name">直播间商品</text><text v-if="item.goods.length==0" class="sub">暂无挂载商品</text><view v-for="goodsItem in item.goods" :key="goodsItem.product_id" class="goods" @click="goods(goodsItem.product_id)"><text>{{goodsItem.store_name||`商品 #${goodsItem.product_id}`}}</text><text class="price">¥{{goodsItem.price}} ›</text></view></view></view></template>
<style>.hero{margin:12px;padding:20px;color:#fff;background:linear-gradient(135deg,#312b50,#7566a9);border-radius:12px}.player{height:220px;margin:12px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#111;color:#d9d9d9;font-size:14px;overflow:hidden}.player video{width:100%;height:100%;background:#000}.name,.sub,.price{display:block}.name{font-size:17px;font-weight:600}.hero .name{font-size:21px}.sub{margin-top:9px;color:#86909c;font-size:13px}.hero .sub{color:#eee}.goods{display:flex;justify-content:space-between;margin-top:12px;padding-top:12px;border-top:1px solid #f0f0f0;color:#4e5969;font-size:14px}.price{color:#d72828;font-weight:600}</style>
