<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
type Product = { product_id:number; store_name:string; mer_name:string; price:number; show_reservation_days:number }
type Slot = { attr_reservation_id:number; label:string; start_time:string; end_time:string; remain:number }
type SlotData = { list:Slot[] }
type Address={address_id:number;is_default:number}; type AddressData={list:Address[]}; type GroupOrder={group_order_id:number}
const id=ref(0); const product=ref<Product|null>(null); const date=ref(''); const slots=ref<Slot[]>([]); const slotID=ref(0); const submitting=ref(false)
function today(): string { const d=new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}` }
function loadSlots(): void { if (id.value>0 && date.value.length>0) appRequest(`/reservation/products/${id.value}/slots?date=${encodeURIComponent(date.value)}`, 'GET', null, false).then((data)=>{slots.value=(data as SlotData).list||[];slotID.value=0}).catch((error)=>uni.showToast({title:error.message||'时段加载失败',icon:'none'})) }
function select(slot:Slot):void { if(slot.remain>0) slotID.value=slot.attr_reservation_id }
function submit():void { if(getAccessToken().length==0){uni.navigateTo({url:'/pages/login/index'});return}; if(slotID.value==0){uni.showToast({title:'请选择可预约时段',icon:'none'});return}; submitting.value=true;let addressID=0;appRequest('/address').then((data)=>{const list=(data as AddressData).list||[];const address=list.find((row)=>row.is_default==1)||(list.length>0?list[0]:null);if(address==null){uni.navigateTo({url:'/pages/address/list'});throw new Error('请先添加收货地址')};addressID=address.address_id;return appRequest('/order/reservation/check','POST',{product_id:id.value,slot_id:slotID.value,date:date.value,address_id:addressID} as UTSJSONObject)}).then(()=>appRequest('/order/reservation/create','POST',{product_id:id.value,slot_id:slotID.value,date:date.value,address_id:addressID} as UTSJSONObject)).then((data)=>{uni.navigateTo({url:`/pages/order/detail?id=${(data as GroupOrder).group_order_id}`})}).catch((error)=>uni.showToast({title:error.message||'预约下单失败',icon:'none'})).finally(()=>{submitting.value=false}) }
onLoad((query)=>{id.value=Number(query['id']||0);date.value=today();if(id.value>0)appRequest(`/reservation/products/${id.value}`,'GET',null,false).then((data)=>{product.value=data as Product;loadSlots()}).catch((error)=>uni.showToast({title:error.message||'服务加载失败',icon:'none'}))})
</script>
<template><view class="qx-page"><qx-nav title="确认预约" /><view v-if="product!=null" class="qx-card"><text class="name">{{product.store_name}}</text><text class="sub">{{product.mer_name}} · ¥{{product.price}}</text><input v-model="date" class="date" placeholder="YYYY-MM-DD" @blur="loadSlots" /></view><view class="qx-card"><text class="name">可选时段</text><view v-if="slots.length==0" class="sub">当日暂无可约时段</view><view v-for="slot in slots" :key="slot.attr_reservation_id" :class="slotID==slot.attr_reservation_id?'slot active':'slot'" @click="select(slot)"><text>{{slot.label||`${slot.start_time}-${slot.end_time}`}}</text><text>余 {{slot.remain}}</text></view></view><view class="footer"><button :loading="submitting" class="qx-primary" @click="submit">确认预约</button></view></view></template>
<style>.name,.sub{display:block}.name{font-size:17px;font-weight:600}.sub{margin-top:9px;color:#86909c;font-size:13px}.date{height:42px;margin-top:14px;padding:0 12px;background:#f6f7f9;border-radius:8px;box-sizing:border-box}.slot{display:flex;justify-content:space-between;margin-top:10px;padding:13px;background:#f6f7f9;border-radius:8px;color:#4e5969;font-size:14px}.active{color:#d72828;background:#fff0f0}.footer{padding:12px;background:#fff}.qx-primary{border-radius:22px;font-size:15px}</style>
