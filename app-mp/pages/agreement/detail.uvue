<script setup lang="uts">
import { appRequest } from '../../common/request'

type Agreement = { key: string; label: string; content: string }
const item = ref<Agreement | null>(null)

function load(key: string): void {
  const safeKey = key.length > 0 ? key : 'sys_user_agree'
  appRequest(`/agreements/${encodeURIComponent(safeKey)}`, 'GET', null, false).then((data) => { item.value = data as Agreement }).catch((error) => uni.showToast({ title: error.message || '协议加载失败', icon: 'none' }))
}
onLoad((query) => load(String(query['key'] || 'sys_user_agree')))
</script>

<template>
  <view class="qx-page"><qx-nav :title="item != null ? item.label : '平台协议'" /><view v-if="item != null" class="article"><text class="title">{{ item.label }}</text><text class="content">{{ item.content }}</text></view></view>
</template>

<style>
.article { padding: 20px; background-color: #ffffff; }.title, .content { display: block; }.title { font-size: 22px; font-weight: 700; }.content { margin-top: 22px; color: #1d2129; font-size: 15px; line-height: 26px; white-space: pre-wrap; }
</style>
