<script setup lang="uts">
import { appRequest } from '../../common/request'
import { getAccessToken } from '../../common/session'
type Topic={topic_id:number;topic_name:string}; type TopicData={list:Topic[]}; type Post={community_id:number;title:string;content:string;nickname:string;topic_name:string;count_reply:number;pv:number;product_name:string;product_price:number}; type PostData={list:Post[]}
const topics=ref<Topic[]>([]);const posts=ref<Post[]>([]);const topicID=ref(0)
function load():void{appRequest('/community/topics','GET',null,false).then((data)=>{topics.value=(data as TopicData).list||[]}).catch(()=>{topics.value=[]});const q=topicID.value>0?`?page=1&limit=30&topic_id=${topicID.value}`:'?page=1&limit=30';appRequest(`/community/posts${q}`,'GET',null,false).then((data)=>{posts.value=(data as PostData).list||[]}).catch((error)=>uni.showToast({title:error.message||'社区内容加载失败',icon:'none'}))}
function select(id:number):void{topicID.value=id;load()} onShow(()=>load())
function detail(id:number):void{uni.navigateTo({url:`/pages/community/detail?id=${id}`})} function create():void{if(getAccessToken().length==0){uni.navigateTo({url:'/pages/login/index'});return};uni.navigateTo({url:'/pages/community/create'})} function mine():void{if(getAccessToken().length==0){uni.navigateTo({url:'/pages/login/index'});return};uni.navigateTo({url:'/pages/community/mine'})}
</script>
<template><view class="qx-page"><qx-nav title="社区"/><view class="tip">内容经平台审核通过后公开展示。<view class="actions"><text class="publish" @click="mine">我的发布</text><text class="publish" @click="create">发布</text></view></view><scroll-view scroll-x class="topics"><text :class="topicID==0?'chip active':'chip'" @click="select(0)">全部</text><text v-for="topic in topics" :key="topic.topic_id" :class="topicID==topic.topic_id?'chip active':'chip'" @click="select(topic.topic_id)">{{topic.topic_name}}</text></scroll-view><view v-if="posts.length==0" class="qx-card empty">暂无社区内容</view><view v-for="post in posts" :key="post.community_id" class="qx-card" @click="detail(post.community_id)"><text class="title">{{post.title}}</text><text class="sub">{{post.nickname||'用户'}} · {{post.topic_name||'话题'}}</text><text class="body">{{post.content}}</text><text v-if="post.product_name" class="goods">挂货 {{post.product_name}} · ¥{{post.product_price}}</text><text class="sub">评论 {{post.count_reply||0}} · 浏览 {{post.pv||0}}</text></view></view></template>
<style>.tip{padding:12px;color:#86909c;font-size:13px}.actions{float:right;display:flex;gap:14px}.publish{color:#d72828}.topics{padding:0 12px 12px;white-space:nowrap}.chip{display:inline-block;margin-right:8px;padding:7px 13px;color:#4e5969;background:#fff;border-radius:16px;font-size:13px}.active{color:#fff;background:#d72828}.empty{color:#86909c;text-align:center}.title,.sub,.body,.goods{display:block}.title{font-size:16px;font-weight:600}.sub{margin-top:8px;color:#86909c;font-size:12px}.body{margin-top:12px;color:#4e5969;font-size:14px;line-height:21px}.goods{margin-top:10px;color:#d72828;font-size:13px}</style>
